# ---------------------------------------------------------------------------
# Restaurant Platform — Environment Variables
# Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Core (required for Phase 1) -------------------------------------------
# PostgreSQL connection string.
DATABASE_URL="postgresql://postgres:devpassword@localhost:5432/restaurant_platform"

# Secret used to sign session JWTs. Generate with: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-secret"

# Public base URL of the application (no trailing slash).
APP_URL="http://localhost:3000"

# --- Customer mobile app (CAPP Phase 1, required) ----------------------------
# Secret used to sign customer-app access/refresh JWTs. Deliberately a
# DIFFERENT value than AUTH_SECRET above — see lib/customer-auth/session.ts.
# Generate with: openssl rand -base64 48
CUSTOMER_AUTH_SECRET="replace-with-a-different-long-random-secret"

# --- Customer mobile app: OAuth / OTP (unconfigured — CAPP Phase 1 seams) ----
# Abstracted behind lib/customer-auth/OAuthProvider.ts and OtpProvider.ts.
# Until these are set, the mobile app only supports email/password
# registration and login — Google/Apple sign-in and mobile-OTP report
# "Integration requires configuration" rather than faking success.
GOOGLE_OAUTH_CLIENT_ID=""
APPLE_OAUTH_CLIENT_ID=""
APPLE_OAUTH_TEAM_ID=""
APPLE_OAUTH_KEY_ID=""
OTP_PROVIDER_KEY=""

# --- Customer mobile app: push notifications (unconfigured — CAPP Phase 9) --
FCM_SERVER_KEY=""
APNS_KEY_ID=""
APNS_TEAM_ID=""

# --- Payments (unconfigured — Phase 4+) -------------------------------------
# Payment provider is abstracted behind lib/payments/PaymentProvider.ts.
# Until these are set, payment features report "Integration requires configuration".
PAYMENT_PROVIDER_KEY=""
PAYMENT_WEBHOOK_SECRET=""

# --- Platform Subscription Billing (unconfigured — Phase 17) ----------------
# Restaurant owners subscribing TO this SaaS platform (recurring, monthly) —
# a completely different money flow from PAYMENT_PROVIDER_KEY above (diners
# paying a restaurant for a one-off order). Abstracted behind
# lib/platform-billing/SubscriptionGatewayProvider.ts. Until these are set,
# Subscription Checkout still renders the price preview but cannot redirect
# to a real secure payment page — see that file's header.
SUBSCRIPTION_PAYMENT_PROVIDER_KEY=""
SUBSCRIPTION_PAYMENT_WEBHOOK_SECRET=""

# Secret used to sign platform-admin session JWTs — the SaaS Owner /
# Platform Administrator console at /platform-admin. Deliberately a
# DIFFERENT value than AUTH_SECRET and CUSTOMER_AUTH_SECRET — see
# lib/platform-admin/session.ts. Generate with: openssl rand -base64 48
PLATFORM_ADMIN_AUTH_SECRET="replace-with-a-different-long-random-secret"

# One-time bootstrap credentials for the FIRST PlatformAdmin account in a
# real deployment (there is no public registration endpoint for this role —
# see PlatformAdminAuthService.ts's header). prisma/seed.ts uses these if
# set; falls back to a clearly-marked dev default otherwise. Rotate the
# password immediately after first login in production.
PLATFORM_ADMIN_BOOTSTRAP_EMAIL=""
PLATFORM_ADMIN_BOOTSTRAP_PASSWORD=""

# Shared secret an EXTERNAL scheduler (cron, a PaaS's built-in cron, or a
# manual ops trigger) presents via the `x-cron-secret` header to call
# POST /api/platform-admin/cron/subscription-retries — see
# SubscriptionRetryService.ts's header for why this codebase has no
# in-process scheduler to call it automatically.
PLATFORM_CRON_SECRET=""

# --- Notifications (unconfigured — Phase 14) --------------------------------
EMAIL_PROVIDER_KEY=""
SMS_PROVIDER_KEY=""
PUSH_NOTIFICATION_KEY=""

# --- Storage (unconfigured — Phase 16) ---------------------------------------
# Object storage provider is abstracted behind lib/storage/StorageProvider.ts.
# Nothing in this codebase performs a real file upload today — see that
# file's header for the full "no fake integrations" rationale.
STORAGE_PROVIDER_KEY=""

# --- Maps / delivery (unconfigured — Phase 6) -------------------------------
MAPS_API_KEY=""

# --- Observability (unconfigured — Phase 16) --------------------------------
# Error-tracking provider (e.g. Sentry). Abstracted behind
# lib/monitoring/ErrorReporter.ts. Application logging (lib/monitoring/logger.ts)
# works fully without this — structured JSON logs always go to stdout/stderr;
# this only adds an aggregation/alerting layer on top.
ERROR_REPORTING_PROVIDER_KEY=""

# --- AI business intelligence (unconfigured — Phase 13) ---------------------
# Read-only analytics access only. Never grant the AI provider database write access.
# Provider is abstracted behind lib/ai/AIProvider.ts and only ever narrates
# services/ai/InsightService.ts's already-computed insights — it is never
# handed a database connection. Until this is set, the AI Business Insights
# dashboard still works fully (InsightService is a deterministic rule
# engine, not a call to this provider) — it just has no extra prose summary.
AI_PROVIDER_KEY=""
