import { describe, it, expect, beforeEach, afterAll } from 'vitest';
import { prisma } from '@/lib/db/prisma';
import { AuthService } from '@/services/auth/AuthService';
import { BranchService } from '@/services/branches/BranchService';
import { TableService } from '@/services/tables/TableService';
import { MenuService } from '@/services/menu/MenuService';
import { OrderService } from '@/services/orders/OrderService';
import { resetDatabase } from '../../helpers/db';
import { ConflictError, NotFoundError } from '@/lib/utils/api-error';

async function setupFixture(suffix: string) {
  const { user } = await AuthService.register({
    organizationName: `Order Test ${suffix}`,
    organizationEmail: `order-test-${suffix}@test.local`,
    firstName: 'Owner',
    lastName: suffix,
    email: `owner@order-test-${suffix}.local`,
    password: 'SuperSecret123!',
    currency: 'PHP',
    timezone: 'Asia/Manila',
  });
  const branch = await BranchService.create(user.organizationId, { name: `Branch ${suffix}`, timezone: 'Asia/Manila' }, user.id);
  const table = await TableService.createTable(user.organizationId, branch.id, { tableNumber: 'T1', capacity: 4 }, user.id);
  const category = await MenuService.createCategory(user.organizationId, { name: 'Mains', displayOrder: 0 }, user.id);
  const item = await MenuService.createItem(
    user.organizationId,
    { categoryId: category.id, name: 'Burger', price: '150.00', available: true, taxCategory: 'STANDARD' },
    user.id,
  );
  const variant = await MenuService.addVariant(user.organizationId, item.id, { name: 'Large', price: '180.00', displayOrder: 0 }, user.id);
  const modGroup = await MenuService.createModifierGroup(
    user.organizationId,
    { name: 'Extras', selectionType: 'MULTIPLE', required: false, minSelect: 0, maxSelect: 2 },
    user.id,
  );
  const modifier = await MenuService.addModifier(user.organizationId, modGroup.id, { name: 'Cheese', priceDelta: '20.00', displayOrder: 0 }, user.id);
  const secondModifier = await MenuService.addModifier(user.organizationId, modGroup.id, { name: 'Bacon', priceDelta: '30.00', displayOrder: 1 }, user.id);
  const thirdModifier = await MenuService.addModifier(user.organizationId, modGroup.id, { name: 'Onion', priceDelta: '5.00', displayOrder: 2 }, user.id);
  await MenuService.linkModifierGroupToItem(user.organizationId, item.id, modGroup.id, user.id);

  return { user, branch, table, category, item, variant, modGroup, modifier, secondModifier, thirdModifier };
}

describe('OrderService', () => {
  beforeEach(async () => {
    await resetDatabase();
  });

  afterAll(async () => {
    await prisma.$disconnect();
  });

  it('computes pricing server-side and snapshots names/prices onto the order', async () => {
    const { user, branch, item, modifier } = await setupFixture('a');
    const order = await OrderService.createOrder(
      user.organizationId,
      branch.id,
      {
        type: 'TAKEOUT',
        discountAmount: '0.00',
        items: [{ menuItemId: item.id, quantity: 2, modifierIds: [modifier.id] }],
      },
      user.id,
    );

    // 2x (150.00 base + 20.00 modifier) = 340.00 subtotal, 12% VAT = 40.80
    expect(order.subtotal.toString()).toBe('340.00');
    expect(order.taxTotal.toString()).toBe('40.80');
    expect(order.total.toString()).toBe('380.80');
    const firstOrderItem = order.items[0];
    if (!firstOrderItem) throw new Error('Expected the Burger order item');
    expect(firstOrderItem.nameSnapshot).toBe('Burger');

    const firstOrderModifier = firstOrderItem.modifiers[0];
    if (!firstOrderModifier) throw new Error('Expected the Cheese modifier');
    expect(firstOrderModifier.nameSnapshot).toBe('Cheese');
  });

  it('prices a variant using the variant price, not the base item price', async () => {
    const { user, branch, item, variant } = await setupFixture('a2');
    const order = await OrderService.createOrder(
      user.organizationId,
      branch.id,
      { type: 'TAKEOUT', discountAmount: '0.00', items: [{ menuItemId: item.id, menuItemVariantId: variant.id, quantity: 1, modifierIds: [] }] },
      user.id,
    );
    expect(order.subtotal.toString()).toBe('180.00');
  });

  it('rejects a menu item from another organization', async () => {
    const orgA = await setupFixture('b');
    const orgB = await setupFixture('c');
    await expect(
      OrderService.createOrder(
        orgB.user.organizationId,
        orgB.branch.id,
        { type: 'TAKEOUT', discountAmount: '0.00', items: [{ menuItemId: orgA.item.id, quantity: 1, modifierIds: [] }] },
        orgB.user.id,
      ),
    ).rejects.toBeInstanceOf(NotFoundError);
  });

  it('rejects a modifier not linked to the requested item', async () => {
    const { user, branch, item } = await setupFixture('d');
    const otherCategory = await MenuService.createCategory(user.organizationId, { name: 'Drinks', displayOrder: 1 }, user.id);
    const otherItem = await MenuService.createItem(
      user.organizationId,
      { categoryId: otherCategory.id, name: 'Soda', price: '50.00', available: true, taxCategory: 'STANDARD' },
      user.id,
    );
    const unrelatedGroup = await MenuService.createModifierGroup(user.organizationId, { name: 'Ice', selectionType: 'SINGLE', required: false, minSelect: 0, maxSelect: 1 }, user.id);
    const unrelatedModifier = await MenuService.addModifier(user.organizationId, unrelatedGroup.id, { name: 'No Ice', priceDelta: '0.00', displayOrder: 0 }, user.id);
    void otherItem;

    await expect(
      OrderService.createOrder(
        user.organizationId,
        branch.id,
        { type: 'TAKEOUT', discountAmount: '0.00', items: [{ menuItemId: item.id, quantity: 1, modifierIds: [unrelatedModifier.id] }] },
        user.id,
      ),
    ).rejects.toBeInstanceOf(ConflictError);
  });

  it('rejects exceeding a modifier group maxSelect', async () => {
    const { user, branch, item, modifier, secondModifier, thirdModifier } = await setupFixture('e');
    await expect(
      OrderService.createOrder(
        user.organizationId,
        branch.id,
        {
          type: 'TAKEOUT',
          discountAmount: '0.00',
          items: [{ menuItemId: item.id, quantity: 1, modifierIds: [modifier.id, secondModifier.id, thirdModifier.id] }],
        },
        user.id,
      ),
    ).rejects.toBeInstanceOf(ConflictError);
  });

  it('auto-transitions an AVAILABLE table to OCCUPIED for a new dine-in order', async () => {
    const { user, branch, table, item } = await setupFixture('f');
    await OrderService.createOrder(
      user.organizationId,
      branch.id,
      { type: 'DINE_IN', tableId: table.id, discountAmount: '0.00', items: [{ menuItemId: item.id, quantity: 1, modifierIds: [] }] },
      user.id,
    );
    const refreshed = await TableService.getTable(user.organizationId, branch.id, table.id);
    expect(refreshed.status).toBe('OCCUPIED');
  });

  it('allows a second dine-in order at an already-OCCUPIED table without error', async () => {
    const { user, branch, table, item } = await setupFixture('g');
    await OrderService.createOrder(
      user.organizationId,
      branch.id,
      { type: 'DINE_IN', tableId: table.id, discountAmount: '0.00', items: [{ menuItemId: item.id, quantity: 1, modifierIds: [] }] },
      user.id,
    );
    const secondOrder = await OrderService.createOrder(
      user.organizationId,
      branch.id,
      { type: 'DINE_IN', tableId: table.id, discountAmount: '0.00', items: [{ menuItemId: item.id, quantity: 1, modifierIds: [] }] },
      user.id,
    );
    expect(secondOrder.status).toBe('PENDING');
  });

  it('rejects seating a new dine-in order at an OUT_OF_SERVICE table', async () => {
    const { user, branch, table, item } = await setupFixture('h');
    await TableService.updateStatus(user.organizationId, branch.id, table.id, { status: 'OUT_OF_SERVICE' }, user.id);
    await expect(
      OrderService.createOrder(
        user.organizationId,
        branch.id,
        { type: 'DINE_IN', tableId: table.id, discountAmount: '0.00', items: [{ menuItemId: item.id, quantity: 1, modifierIds: [] }] },
        user.id,
      ),
    ).rejects.toBeInstanceOf(ConflictError);
  });

  it('rejects an illegal status transition (PENDING -> READY)', async () => {
    const { user, branch, item } = await setupFixture('i');
    const order = await OrderService.createOrder(
      user.organizationId,
      branch.id,
      { type: 'TAKEOUT', discountAmount: '0.00', items: [{ menuItemId: item.id, quantity: 1, modifierIds: [] }] },
      user.id,
    );
    await expect(
      OrderService.updateStatus(user.organizationId, branch.id, order.id, { status: 'READY' }, user.id),
    ).rejects.toBeInstanceOf(ConflictError);
  });

  it('walks an order through its full legal lifecycle', async () => {
    const { user, branch, item } = await setupFixture('j');
    const order = await OrderService.createOrder(
      user.organizationId,
      branch.id,
      { type: 'TAKEOUT', discountAmount: '0.00', items: [{ menuItemId: item.id, quantity: 1, modifierIds: [] }] },
      user.id,
    );
    for (const status of ['CONFIRMED', 'PREPARING', 'READY', 'COMPLETED'] as const) {
      const updated = await OrderService.updateStatus(user.organizationId, branch.id, order.id, { status }, user.id);
      expect(updated.status).toBe(status);
    }
  });

  it('requires a cancellation reason to cancel', async () => {
    const { user, branch, item } = await setupFixture('k');
    const order = await OrderService.createOrder(
      user.organizationId,
      branch.id,
      { type: 'TAKEOUT', discountAmount: '0.00', items: [{ menuItemId: item.id, quantity: 1, modifierIds: [] }] },
      user.id,
    );
    await expect(
      OrderService.updateStatus(user.organizationId, branch.id, order.id, { status: 'CANCELLED' }, user.id),
    ).rejects.toBeInstanceOf(ConflictError);
  });

  it('records payments and computes paid/balance correctly, including a refund', async () => {
    const { user, branch, item } = await setupFixture('l');
    const order = await OrderService.createOrder(
      user.organizationId,
      branch.id,
      { type: 'TAKEOUT', discountAmount: '0.00', items: [{ menuItemId: item.id, quantity: 1, modifierIds: [] }] },
      user.id,
    );
    // total = 150.00 + 12% = 168.00
    const afterPayment = await OrderService.recordPayment(
      user.organizationId, branch.id, order.id, { method: 'CASH', amount: '168.00', status: 'COMPLETED' }, user.id,
    );
    let summary = OrderService.paymentSummary(afterPayment);
    expect(summary.isFullyPaid).toBe(true);
    expect(summary.balanceDue).toBe('0.00');

    const afterRefund = await OrderService.recordPayment(
      user.organizationId, branch.id, order.id, { method: 'CASH', amount: '68.00', status: 'REFUNDED', note: 'Partial refund' }, user.id,
    );
    summary = OrderService.paymentSummary(afterRefund);
    expect(summary.paidAmount).toBe('100.00');
    expect(summary.isFullyPaid).toBe(false);
  });

  it('does not expose an order from another organization', async () => {
    const orgA = await setupFixture('m');
    const orgB = await setupFixture('n');
    const order = await OrderService.createOrder(
      orgA.user.organizationId,
      orgA.branch.id,
      { type: 'TAKEOUT', discountAmount: '0.00', items: [{ menuItemId: orgA.item.id, quantity: 1, modifierIds: [] }] },
      orgA.user.id,
    );
    await expect(
      OrderService.get(orgB.user.organizationId, orgB.branch.id, order.id),
    ).rejects.toBeInstanceOf(NotFoundError);
  });
});
