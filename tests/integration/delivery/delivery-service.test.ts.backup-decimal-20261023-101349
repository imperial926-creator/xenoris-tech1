async function createDriverRoleUser(organizationId: string, suffix: string) {
  const driverRole = await prisma.role.findFirstOrThrow({ where: { organizationId, name: 'DRIVER' } });
  const driverUser = await prisma.user.create({
    data: {
      organizationId,
      email: `driver-${suffix}@delivery-test.local`,
      passwordHash: 'irrelevant-for-this-test',
      firstName: 'Drive',
      lastName: suffix,
    },
  });
  await prisma.userRole.create({ data: { userId: driverUser.id, roleId: driverRole.id, organizationId } });
  return driverUser;
}

async function createDeliveryOrder(
  user: { organizationId: string; id: string },
  branch: { id: string },
  item: { id: string },
  zone?: { id: string },
) {
  return OrderService.createOrder(
    user.organizationId,
    branch.id,
    {
      type: 'DELIVERY',
      deliveryAddress: '1 Test St',
      deliveryZoneId: zone?.id,
      discountAmount: '0.00',
      items: [{ menuItemId: item.id, quantity: 1, modifierIds: [] }],
    },
    user.id,
  );
}

describe('DeliveryOrder auto-creation on OrderService.createOrder', () => {
  beforeEach(async () => {
    await resetDatabase();
  });

  afterAll(async () => {
    await prisma.$disconnect();
  });

  it('creates a companion DeliveryOrder for a DELIVERY order and snapshots the zone fee', async () => {
    const { user, branch, item, zone } = await setupFixture('a');
    const order = await createDeliveryOrder(user, branch, item, zone);

    // Burger 150.00 x1 -> subtotal 150.00, 12% VAT = 18.00, + 50.00 delivery
    // fee -> total 218.00. Exact assertion, mirroring the migration smoke
    // test's 228.00 example.
    expect(order.subtotal.toString()).toBe('150.00');
    expect(order.taxTotal.toString()).toBe('18.00');
    expect(order.deliveryFee.toString()).toBe('50.00');
    expect(order.total.toString()).toBe('218.00');

    expect(order.delivery).toBeTruthy();
    expect(order.delivery?.status).toBe('UNASSIGNED');
    expect(order.delivery?.deliveryZoneId).toBe(zone.id);
    expect(order.delivery?.deliveryFee.toString()).toBe('50.00');

    const history = await DeliveryService.getStatusHistory(user.organizationId, branch.id, order.delivery!.id);
    expect(history).toHaveLength(1);
    const firstHistoryEntry = history[0];
    if (!firstHistoryEntry) throw new Error('Expected a delivery status history entry');
    expect(firstHistoryEntry.toStatus).toBe('UNASSIGNED');
    expect(firstHistoryEntry.fromStatus).toBeNull();
  });

  it('does not create a DeliveryOrder for a non-DELIVERY order', async () => {
    const { user, branch, item } = await setupFixture('b');
    const order = await OrderService.createOrder(
      user.organizationId, branch.id,
      { type: 'TAKEOUT', discountAmount: '0.00', items: [{ menuItemId: item.id, quantity: 1, modifierIds: [] }] },
      user.id,
    );
    expect(order.delivery).toBeNull();
    expect(order.deliveryFee.toString()).toBe('0.00');
  });

  it('allows a DELIVERY order with no zone yet â€” deliveryFee stays 0', async () => {
    const { user, branch, item } = await setupFixture('c');
    const order = await createDeliveryOrder(user, branch, item);
    expect(order.deliveryFee.toString()).toBe('0.00');
    expect(order.delivery?.deliveryZoneId).toBeNull();
  });

  it('rejects an inactive delivery zone', async () => {
    const { user, branch, item, zone } = await setupFixture('d');
    await DeliveryZoneService.update(user.organizationId, branch.id, zone.id, { active: false }, user.id);
    await expect(createDeliveryOrder(user, branch, item, zone)).rejects.toBeInstanceOf(ConflictError);
  });
});

describe('DeliveryService.assignDriver', () => {
  beforeEach(async () => {
    await resetDatabase();
  });

  afterAll(async () => {
    await prisma.$disconnect();
  });

  it('assigns a driver, moves status to ASSIGNED, and records one open assignment', async () => {
    const { user, branch, item, zone } = await setupFixture('e');
    const order = await createDeliveryOrder(user, branch, item, zone);
    const driverUser = await createDriverRoleUser(user.organizationId, 'e');
    const driver = await DriverService.create(user.organizationId, branch.id, { userId: driverUser.id }, user.id);

    const delivery = await DeliveryService.assignDriver(
      user.organizationId, branch.id, order.delivery!.id, { driverId: driver.id }, user.id,
    );
    expect(delivery.status).toBe('ASSIGNED');
    expect(delivery.driverId).toBe(driver.id);

    const assignments = await prisma.driverAssignment.findMany({ where: { deliveryOrderId: order.delivery!.id } });
    expect(assignments).toHaveLength(1);
    const firstAssignment = assignments[0];
    if (!firstAssignment) throw new Error('Expected a driver assignment');
    expect(firstAssignment.unassignedAt).toBeNull();
  });

  it('reassigning to a different driver closes the prior assignment and opens exactly one new one', async () => {
    const { user, branch, item, zone } = await setupFixture('f');
    const order = await createDeliveryOrder(user, branch, item, zone);
    const driverUser1 = await createDriverRoleUser(user.organizationId, 'f1');
    const driverUser2 = await createDriverRoleUser(user.organizationId, 'f2');
    const driver1 = await DriverService.create(user.organizationId, branch.id, { userId: driverUser1.id }, user.id);
    const driver2 = await DriverService.create(user.organizationId, branch.id, { userId: driverUser2.id }, user.id);

    await DeliveryService.assignDriver(user.organizationId, branch.id, order.delivery!.id, { driverId: driver1.id }, user.id);
    const reassigned = await DeliveryService.assignDriver(
      user.organizationId, branch.id, order.delivery!.id, { driverId: driver2.id }, user.id,
    );
    expect(reassigned.driverId).toBe(driver2.id);

    const assignments = await prisma.driverAssignment.findMany({
      where: { deliveryOrderId: order.delivery!.id },
      orderBy: { assignedAt: 'asc' },
    });
    expect(assignments).toHaveLength(2);
    const firstAssignment = assignments[0];
    const secondAssignment = assignments[1];
    if (!firstAssignment || !secondAssignment) {
      throw new Error('Expected two driver assignments after reassignment');
    }
    expect(firstAssignment.driverId).toBe(driver1.id);
    expect(firstAssignment.unassignedAt).not.toBeNull();
    expect(secondAssignment.driverId).toBe(driver2.id);
    expect(secondAssignment.unassignedAt).toBeNull();

    const openAssignments = assignments.filter((a) => a.unassignedAt === null);
    expect(openAssignments).toHaveLength(1);
  });

  it('rejects assigning the same driver the delivery is already assigned to', async () => {
    const { user, branch, item, zone } = await setupFixture('g');
    const order = await createDeliveryOrder(user, branch, item, zone);
    const driverUser = await createDriverRoleUser(user.organizationId, 'g');
    const driver = await DriverService.create(user.organizationId, branch.id, { userId: driverUser.id }, user.id);
    await DeliveryService.assignDriver(user.organizationId, branch.id, order.delivery!.id, { driverId: driver.id }, user.id);

    await expect(
      DeliveryService.assignDriver(user.organizationId, branch.id, order.delivery!.id, { driverId: driver.id }, user.id),
    ).rejects.toBeInstanceOf(ConflictError);
  });

  it('rejects assigning once the delivery has already been picked up', async () => {
    const { user, branch, item, zone } = await setupFixture('h');
    const order = await createDeliveryOrder(user, branch, item, zone);
    const driverUser1 = await createDriverRoleUser(user.organizationId, 'h1');
    const driverUser2 = await createDriverRoleUser(user.organizationId, 'h2');
    const driver1 = await DriverService.create(user.organizationId, branch.id, { userId: driverUser1.id }, user.id);
    const driver2 = await DriverService.create(user.organizationId, branch.id, { userId: driverUser2.id }, user.id);
    await DeliveryService.assignDriver(user.organizationId, branch.id, order.delivery!.id, { driverId: driver1.id }, user.id);
    await DeliveryService.updateStatus(user.organizationId, branch.id, order.delivery!.id, { status: 'PICKED_UP' }, user.id);

    await expect(
      DeliveryService.assignDriver(user.organizationId, branch.id, order.delivery!.id, { driverId: driver2.id }, user.id),
    ).rejects.toBeInstanceOf(ConflictError);
  });
});

describe('DeliveryService.updateStatus', () => {
  beforeEach(async () => {
    await resetDatabase();
  });

  afterAll(async () => {
    await prisma.$disconnect();
  });

  async function assignedDelivery(suffix: string) {
    const { user, branch, item, zone } = await setupFixture(suffix);
    const order = await createDeliveryOrder(user, branch, item, zone);
    const driverUser = await createDriverRoleUser(user.organizationId, suffix);
    const driver = await DriverService.create(user.organizationId, branch.id, { userId: driverUser.id }, user.id);
    const delivery = await DeliveryService.assignDriver(
      user.organizationId, branch.id, order.delivery!.id, { driverId: driver.id }, user.id,
    );
    return { user, branch, delivery };
  }

  it('walks UNASSIGNED -> ASSIGNED -> PICKED_UP -> DELIVERED', async () => {
    const { user, branch, delivery } = await assignedDelivery('i');
    const pickedUp = await DeliveryService.updateStatus(user.organizationId, branch.id, delivery.id, { status: 'PICKED_UP' }, user.id);
    expect(pickedUp.status).toBe('PICKED_UP');
    expect(pickedUp.pickedUpAt).not.toBeNull();

    const delivered = await DeliveryService.updateStatus(
      user.organizationId, branch.id, delivery.id,
      { status: 'DELIVERED', proofOfDeliveryNote: 'Left at door.', recipientName: 'J. Cruz' },
      user.id,
    );
    expect(delivered.status).toBe('DELIVERED');
    expect(delivered.deliveredAt).not.toBeNull();
    expect(delivered.proofOfDeliveryNote).toBe('Left at door.');
    expect(delivered.recipientName).toBe('J. Cruz');
  });

  it('rejects marking PICKED_UP before a driver is assigned', async () => {
    const { user, branch, item, zone } = await setupFixture('j');
    const order = await createDeliveryOrder(user, branch, item, zone);
    await expect(
      DeliveryService.updateStatus(user.organizationId, branch.id, order.delivery!.id, { status: 'PICKED_UP' }, user.id),
    ).rejects.toBeInstanceOf(ConflictError);
  });

  it('rejects an illegal transition (UNASSIGNED -> DELIVERED)', async () => {
    const { user, branch, item, zone } = await setupFixture('k');
    const order = await createDeliveryOrder(user, branch, item, zone);
    await expect(
      DeliveryService.updateStatus(user.organizationId, branch.id, order.delivery!.id, { status: 'DELIVERED' }, user.id),
    ).rejects.toBeInstanceOf(ConflictError);
  });

  it('requires a note when marking CANCELLED or FAILED', async () => {
    const { user, branch, delivery } = await assignedDelivery('l');
    await expect(
      DeliveryService.updateStatus(user.organizationId, branch.id, delivery.id, { status: 'CANCELLED' }, user.id),
    ).rejects.toBeInstanceOf(ConflictError);
    await expect(
      DeliveryService.updateStatus(user.organizationId, branch.id, delivery.id, { status: 'CANCELLED', note: 'Customer cancelled.' }, user.id),
    ).resolves.toBeTruthy();
  });

  it('rejects advancing a delivery belonging to another organization', async () => {
    const { delivery } = await assignedDelivery('m');
    const orgB = await setupFixture('n');
    await expect(
      DeliveryService.updateStatus(orgB.user.organizationId, orgB.branch.id, delivery.id, { status: 'PICKED_UP' }, orgB.user.id),
    ).rejects.toBeInstanceOf(NotFoundError);
  });
});

describe('DeliveryService.myDeliveries', () => {
  beforeEach(async () => {
    await resetDatabase();
  });

  afterAll(async () => {
    await prisma.$disconnect();
  });

  it('returns only the calling driver\'s own deliveries, never another driver\'s', async () => {
    const { user, branch, item, zone } = await setupFixture('o');
    const orderForDriver1 = await createDeliveryOrder(user, branch, item, zone);
    const orderForDriver2 = await createDeliveryOrder(user, branch, item, zone);

    const driverUser1 = await createDriverRoleUser(user.organizationId, 'o1');
    const driverUser2 = await createDriverRoleUser(user.organizationId, 'o2');
    const driver1 = await DriverService.create(user.organizationId, branch.id, { userId: driverUser1.id }, user.id);
    const driver2 = await DriverService.create(user.organizationId, branch.id, { userId: driverUser2.id }, user.id);

    await DeliveryService.assignDriver(user.organizationId, branch.id, orderForDriver1.delivery!.id, { driverId: driver1.id }, user.id);
    await DeliveryService.assignDriver(user.organizationId, branch.id, orderForDriver2.delivery!.id, { driverId: driver2.id }, user.id);

    const driver1Deliveries = await DeliveryService.myDeliveries(user.organizationId, driverUser1.id);
    expect(driver1Deliveries).toHaveLength(1);
    const driver1Delivery = driver1Deliveries[0];
    if (!driver1Delivery) throw new Error('Expected a delivery for driver 1');
    expect(driver1Delivery.id).toBe(orderForDriver1.delivery!.id);

    const driver2Deliveries = await DeliveryService.myDeliveries(user.organizationId, driverUser2.id);
    expect(driver2Deliveries).toHaveLength(1);
    const driver2Delivery = driver2Deliveries[0];
    if (!driver2Delivery) throw new Error('Expected a delivery for driver 2');
    expect(driver2Delivery.id).toBe(orderForDriver2.delivery!.id);
  });

  it('throws NotFoundError for a user with no driver profile', async () => {
    const { user } = await setupFixture('p');
    await expect(DeliveryService.myDeliveries(user.organizationId, user.id)).rejects.toBeInstanceOf(NotFoundError);
  });

  it('does not leak deliveries across organizations even with a matching driver id shape', async () => {
    const orgA = await setupFixture('q');
    const orgB = await setupFixture('r');
    const orderA = await createDeliveryOrder(orgA.user, orgA.branch, orgA.item, orgA.zone);
    const driverUserA = await createDriverRoleUser(orgA.user.organizationId, 'q');
    const driverA = await DriverService.create(orgA.user.organizationId, orgA.branch.id, { userId: driverUserA.id }, orgA.user.id);
    await DeliveryService.assignDriver(orgA.user.organizationId, orgA.branch.id, orderA.delivery!.id, { driverId: driverA.id }, orgA.user.id);

    await expect(DeliveryService.myDeliveries(orgB.user.organizationId, driverUserA.id)).rejects.toBeInstanceOf(NotFoundError);
  });
});
