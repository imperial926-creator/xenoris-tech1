// ---------------------------------------------------------------------------
// Restaurant Platform — Prisma Schema
// Phase 1 (Foundation) scope only: organizations, branches, users, RBAC, audit log.
// See docs/database.md for conventions and the forward-looking schema for later phases.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  legalName String?
  email     String   @unique
  phone     String?
  currency  String   @default("PHP")
  timezone  String   @default("Asia/Manila")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches  Branch[]
  users     User[]
  roles     Role[]
  userRoles UserRole[]
  auditLogs AuditLog[]
  menuCategories     MenuCategory[]
  menuItems          MenuItem[]
  menuModifierGroups MenuModifierGroup[]
  reservations       Reservation[]
  orders             Order[]
  invoices           Invoice[]
  deliveryZones      DeliveryZone[]
  drivers            Driver[]
  deliveryOrders     DeliveryOrder[]
  cateringPackages   CateringPackage[]
  cateringInquiries  CateringInquiry[]
  cateringQuotes     CateringQuote[]
  cateringEvents     CateringEvent[]
  cateringPayments   CateringPayment[]
  customers          Customer[]
  customerReviews    CustomerReview[]
  units               Unit[]
  ingredients         Ingredient[]
  recipes             Recipe[]
  inventoryItems      InventoryItem[]
  inventoryTransactions InventoryTransaction[]
  suppliers           Supplier[]
  purchaseOrders      PurchaseOrder[]
  stockCounts         StockCount[]
  wasteRecords        WasteRecord[]
  chartOfAccounts       ChartOfAccount[]
  accountingPeriods     AccountingPeriod[]
  journalEntries        JournalEntry[]
  financialTransactions FinancialTransaction[]
  expenseCategories     ExpenseCategory[]
  vendors               Vendor[]
  expenses              Expense[]
  notifications         Notification[]

  // Phase 8 — CRM. Per-organization overrides for the RFM segmentation
  // thresholds in lib/crm/rfm.ts (recency/frequency/monetary cutoffs).
  // Nullable: null means "use DEFAULT_RFM_THRESHOLDS", the same
  // "JSON column, code supplies the default" pattern as Branch.openingHours.
  // Master spec §32 says "make thresholds configurable" without specifying
  // a settings UI/table shape — this is the smallest additive way to honor
  // that per-organization, without a new table for a handful of numbers.
  crmSettings Json?

  // Phase 13 — AI. Per-organization overrides for the insight-generation
  // thresholds in lib/ai/thresholds.ts (how big a swing in sales/margin/
  // expense/waste/repeat-rate counts as worth surfacing). Same "nullable
  // JSON column, code supplies the default" pattern as crmSettings directly
  // above — master spec's own "All rules must be configurable" line (§37,
  // the section immediately preceding AI Business Intelligence) applies to
  // these rules exactly as it did to RFM's.
  aiSettings Json?

  // --- CAPP Phase 1 — Customer app -----------------------------------------
  // Public, customer-facing tenant identifier ("restaurant_id" in the
  // customer-app spec) — sequential, human-readable, generated via
  // PlatformSequence the same atomic-increment pattern InvoiceSequence
  // already uses for invoice numbers. Deliberately distinct from `id`
  // (internal cuid, used for every server-side FK): every /api/v1/**
  // customer-app route and every deep link/QR code uses this instead of
  // the internal id — see docs/customer-app/architecture.md § 2.
  publicCode          String?  @unique
  // Nullable JSON settings bag for the customer app, mirroring
  // crmSettings/aiSettings above — no fields are specified by the spec
  // beyond the table's existence (§40 "restaurant_settings"), so this
  // stays a JSON column code supplies defaults for rather than a guessed
  // fixed schema.
  customerAppSettings Json?

  branding       RestaurantBranding?
  realtimeEvents RealtimeEvent[]

  // CAPP Phase 8 — Promotions.
  promotions          Promotion[]
  promotionCampaigns  PromotionCampaign[]
  customerPromotions  CustomerPromotion[]
  promotionRedemptions PromotionRedemption[]
  // CAPP Phase 9 — Notifications.
  customerNotifications CustomerNotification[]
  // CAPP Phase 10 — Loyalty, favorites, upselling.
  loyaltyAccounts         LoyaltyAccount[]
  customerFavorites       CustomerFavorite[]
  menuItemRecommendations MenuItemRecommendation[]
  // CAPP Phase 11 — Analytics.
  customerAnalyticsEvents CustomerAnalyticsEvent[]

  // Phase 17 — Platform Subscription Billing. This is the one relation
  // block in this model that points the other direction from everything
  // above: every other relation here is "this restaurant's own
  // operational data" (orders it took, menu it sells). A
  // Subscription/BillingCustomer is "this restaurant AS A CUSTOMER of the
  // SaaS platform itself" — see the big comment block above the
  // Subscription model for why that distinction forced a whole separate,
  // non-org-scoped admin actor (PlatformAdmin) instead of reusing
  // User/Role/AuditLog like everything else in this schema does.
  billingCustomer      BillingCustomer?
  subscription         Subscription?
  subscriptionPayments SubscriptionPayment[]
  platformInvoices     PlatformInvoice[]
  platformRefunds      PlatformRefund[]
  paymentDisputes      PaymentDispute[]
  actionCenterTasks    ActionCenterTask[]

  // Phase 18 — Data Analytics & Business Intelligence + Action Center
  // Extension. Same "this restaurant as the SaaS platform's own subject of
  // analysis" direction as the Phase 17 block above, not this restaurant's
  // operational data.
  lifecycleEvents         RestaurantLifecycleEvent[]
  mrrMovementEvents       MrrMovementEvent[]
  complaints              Complaint[]
  engagementSnapshots     RestaurantEngagementSnapshot[]
  platformAnalyticsEvents PlatformAnalyticsEvent[]
  platformHealthEvents    PlatformHealthEvent[]

  @@map("organizations")
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  TEMPORARILY_CLOSED
}

// Phase 15 hardening (database review): the financial/historical child
// models below (Invoice, InventoryTransaction, PurchaseOrder, WasteRecord,
// CateringPayment, JournalEntry, FinancialTransaction, Expense) all use
// onDelete: Restrict on their `branch` relation, not Cascade — deleting a
// branch must never silently delete or orphan a ledger/audit trail record.
// A branch with financial history has to be deactivated (BranchStatus),
// not hard-deleted, which this now enforces at the DB level rather than
// only by convention. See migration 20260818040000_phase15_db_financial_hardening.
model Branch {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  address        String?
  phone          String?
  email          String?
  timezone       String       @default("Asia/Manila")
  openingHours   Json?
  status         BranchStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userRoles    UserRole[]
  auditLogs    AuditLog[]
  tableSections TableSection[]
  tables        RestaurantTable[]
  reservations  Reservation[]
  orders        Order[]
  invoices      Invoice[]
  invoiceSequence InvoiceSequence?
  deliveryZones DeliveryZone[]
  drivers       Driver[]
  deliveryOrders DeliveryOrder[]
  cateringPackages  CateringPackage[]
  cateringInquiries CateringInquiry[]
  cateringQuotes    CateringQuote[]
  cateringEvents    CateringEvent[]
  cateringPayments  CateringPayment[]
  customerReviews   CustomerReview[]
  inventoryItems        InventoryItem[]
  inventoryTransactions InventoryTransaction[]
  purchaseOrders        PurchaseOrder[]
  stockCounts           StockCount[]
  wasteRecords          WasteRecord[]
  journalEntries        JournalEntry[]
  financialTransactions FinancialTransaction[]
  expenses              Expense[]
  notifications         Notification[]

  @@index([organizationId])
  @@map("branches")
}

// ---------------------------------------------------------------------------
// Users & RBAC
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DEACTIVATED
}

model User {
  id             String     @id @default(cuid())
  organizationId String
  email          String
  passwordHash   String
  firstName      String
  lastName       String
  phone          String?
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userRoles    UserRole[]
  auditLogs    AuditLog[]
  // Reservations made under this user's account. Optional on the Reservation
  // side — walk-in/phone bookings have no registered user at all (Phase 8
  // full CRM identity is a later phase; this is just "was there an account").
  reservations Reservation[]
  orders       Order[]
  // A Driver profile exists only for users actually dispatched for delivery
  // (typically, but not necessarily only, those with the DRIVER role) — see
  // the "Phase 6 — Delivery" comment block near the Driver model.
  driverProfile Driver?
  // Catering inquiries/events made under this user's account — optional,
  // same "was there an account" pattern as Reservation/Order's
  // customerUserId (Phase 7).
  cateringInquiries CateringInquiry[]
  cateringEvents    CateringEvent[]

  // Phase 8 — CRM. The real customer identity/profile record, if this user
  // has one — see the "Phase 8 — CRM" comment block near the Customer model
  // for why this is a separate table from User rather than fields bolted on
  // here (most customers never register an account at all).
  customerProfile         Customer?
  customerNotesAuthored   CustomerNote[]
  customerTagsCreated     CustomerTag[]
  customerReviewsRecorded CustomerReview[]

  // Phase 9 — Inventory. Optional "who recorded/actioned this" links —
  // same SetNull-on-delete pattern as every other staff-attribution field
  // in this schema (CustomerNote.authorUserId, CateringPayment.recordedByUserId).
  inventoryTransactionsRecorded InventoryTransaction[]
  purchaseOrdersCreated         PurchaseOrder[]
  stockCountsRecorded           StockCount[]
  wasteRecordsRecorded          WasteRecord[]

  // Phase 10 — Accounting. Same "who actioned this" attribution pattern —
  // journal entry creation and posting are tracked as separate actors/
  // moments (a drafted manual entry may be posted later, by someone else),
  // per master spec §45's "create" vs. "post" being distinct responsibilities.
  accountingPeriodsClosed    AccountingPeriod[]
  journalEntriesCreated      JournalEntry[]       @relation("JournalEntryCreatedBy")
  journalEntriesPosted       JournalEntry[]       @relation("JournalEntryPostedBy")
  expensesRecorded           Expense[]            @relation("ExpenseRecordedBy")
  expensesApproved           Expense[]            @relation("ExpenseApprovedBy")
  expenseAttachmentsUploaded ExpenseAttachment[]

  // Phase 18 — a restaurant-owner-side staff account raising a complaint
  // TO the SaaS platform (distinct from CustomerReview, which is a diner
  // reviewing the restaurant). Optional — see Complaint.raisedByUserId's
  // own comment for why this can be null.
  complaintsRaised Complaint[]

  // Email is unique per organization, not globally — the same person may be a
  // customer of multiple independent restaurant organizations on the platform.
  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

// Global catalog of role names used by seed data & UI. Organizations may define
// additional custom roles later; these are the seven the spec mandates.
enum RoleName {
  CUSTOMER
  STAFF
  MANAGER
  ACCOUNTANT
  DRIVER
  OWNER
  ADMINISTRATOR
}

model Role {
  id             String   @id @default(cuid())
  organizationId String
  name           RoleName
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

// Platform-wide catalog of grantable permissions. Format: "<domain>:<action>",
// e.g. "org:manage", "branch:manage", "user:manage", "reservation:manage".
model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id             String   @id @default(cuid())
  userId         String
  roleId         String
  organizationId String
  // Optional: a role assignment can be scoped to a single branch (e.g. a manager
  // at exactly one branch). Null means org-wide for that role.
  branchId       String?
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: Cascade)

  // Note: because branchId is nullable, Postgres treats each NULL as distinct
  // for uniqueness purposes — this constraint does NOT prevent granting the
  // same org-wide (branchId = null) role to a user twice via a race
  // condition. AuthService/seed avoid this by construction (one create per
  // role per user). Revisit with a partial unique index if that becomes a
  // real risk once open staff-invite flows exist (Phase 2+).
  @@unique([userId, roleId, branchId])
  @@index([organizationId])
  @@index([userId])
  @@map("user_roles")
}

// ---------------------------------------------------------------------------
// Audit Log
// ---------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String?
  userId         String?
  action         String
  entityType     String
  entityId       String
  previousValue  Json?
  newValue       Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Phase 2 — Restaurant Configuration: Tables
// ---------------------------------------------------------------------------

model TableSection {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String
  name           String
  description    String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  branch Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tables RestaurantTable[]

  // Phase 15 hardening: was a plain @@unique([branchId, name]), which
  // permanently blocks reusing a section name after deactivation (active =
  // false) — the same "partial unique index, no representation in Prisma's
  // schema DSL" gap documented in the Order model's header comment (§5) for
  // invoices_one_active_per_order. Hand-written directly into the migration
  // SQL instead: CREATE UNIQUE INDEX table_sections_branchId_name_active_key
  // ON table_sections ("branchId", "name") WHERE (active);
  @@index([organizationId])
  @@index([branchId])
  @@map("table_sections")
}

enum TableStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  WAITING
  CLEANING
  OUT_OF_SERVICE
}

model RestaurantTable {
  id             String      @id @default(cuid())
  organizationId String
  branchId       String
  sectionId      String?
  tableNumber    String
  capacity       Int
  status         TableStatus @default(AVAILABLE)
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  branch        Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  section       TableSection?        @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  statusHistory TableStatusHistory[]
  reservationTables ReservationTable[]
  orders        Order[]

  // Table numbers only need to be unique within a branch, not globally —
  // two branches can both have a "Table 1".
  @@unique([branchId, tableNumber])
  @@index([organizationId])
  @@index([branchId])
  @@map("restaurant_tables")
}

model TableStatusHistory {
  id            String      @id @default(cuid())
  tableId       String
  fromStatus    TableStatus?
  toStatus      TableStatus
  changedByUserId String?
  note          String?
  createdAt     DateTime    @default(now())

  table RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tableId, createdAt])
  @@map("table_status_history")
}

// ---------------------------------------------------------------------------
// Phase 2 — Restaurant Configuration: Menu
// ---------------------------------------------------------------------------

model MenuCategory {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  displayOrder   Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items        MenuItem[]

  // Phase 15 hardening: partial unique index (WHERE active), hand-written
  // in the migration SQL — see TableSection's comment above for the full
  // rationale. CREATE UNIQUE INDEX menu_categories_organizationId_name_active_key
  // ON menu_categories ("organizationId", "name") WHERE (active);
  @@index([organizationId])
  @@map("menu_categories")
}

// Not in the master spec's literal table list but required to express real
// "choose one" (e.g. Size) vs "choose any" (e.g. Add-ons) modifier semantics
// that Phase 4 order-taking needs — a flat, ungrouped modifier list can't
// represent that distinction. See docs/database.md for the note.
model MenuModifierGroup {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  // SINGLE = radio-button choice (e.g. "Size"), MULTIPLE = checkbox choices
  // (e.g. "Add-ons").
  selectionType  ModifierSelectionType @default(SINGLE)
  required       Boolean  @default(false)
  minSelect      Int      @default(0)
  maxSelect      Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  modifiers    MenuModifier[]
  itemLinks    MenuItemModifierGroup[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("menu_modifier_groups")
}

enum ModifierSelectionType {
  SINGLE
  MULTIPLE
}

model MenuModifier {
  id              String   @id @default(cuid())
  modifierGroupId String
  name            String
  // Additive price change when this modifier is selected — never negative
  // discounting hidden in a modifier; discounts are a separate, explicit
  // concept (Phase 4).
  priceDelta      Decimal  @default(0) @db.Decimal(10, 2)
  active          Boolean  @default(true)
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  modifierGroup MenuModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  orderItemModifiers OrderItemModifier[]

  @@unique([modifierGroupId, name])
  @@index([modifierGroupId])
  @@map("menu_modifiers")
}

model MenuItem {
  id              String   @id @default(cuid())
  organizationId String
  categoryId      String
  name            String
  description     String?
  price           Decimal  @db.Decimal(10, 2)
  cost            Decimal? @db.Decimal(10, 2)
  preparationTimeMinutes Int?
  available       Boolean  @default(true)
  imageUrl        String?
  // Kept intentionally simple (a string, not a hard-coded tax engine) —
  // real VAT/zero-rated/exempt treatment must be confirmed by a PH tax
  // professional before this drives real invoicing math. See CLAUDE.md.
  taxCategory     String   @default("STANDARD")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category     MenuCategory            @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants     MenuItemVariant[]
  modifierGroups MenuItemModifierGroup[]
  orderItems   OrderItem[]
  // Phase 9 — Inventory. At most one Recipe per menu item (a recipe
  // describes how to make this specific item, not its variants — see the
  // "Phase 9 — Inventory" comment block for why variant-level recipes are
  // out of scope this phase).
  recipe       Recipe?
  // CAPP Phase 10 — spec § 38 "Favorite items."
  favoritedBy  CustomerFavorite[]
  // CAPP Phase 10 — spec § 39 "Upselling." Both directions of the
  // self-referencing pair: this item as the one being viewed/ordered
  // (`recommendationsFrom`, e.g. Burger) and this item as the one being
  // suggested (`recommendationsAsTarget`, e.g. Fries) — see
  // MenuItemRecommendation's own comment block for why two named relations
  // are needed on one self-referencing model.
  recommendationsFrom     MenuItemRecommendation[] @relation("MenuItemRecommendationSource")
  recommendationsAsTarget MenuItemRecommendation[] @relation("MenuItemRecommendationTarget")

  @@index([organizationId])
  @@index([categoryId])
  @@map("menu_items")
}

model MenuItemVariant {
  id         String   @id @default(cuid())
  menuItemId String
  name       String
  price      Decimal  @db.Decimal(10, 2)
  cost       Decimal? @db.Decimal(10, 2)
  active     Boolean  @default(true)
  displayOrder Int    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([menuItemId, name])
  @@index([menuItemId])
  @@map("menu_item_variants")
}

model MenuItemModifierGroup {
  id              String   @id @default(cuid())
  menuItemId      String
  modifierGroupId String
  createdAt       DateTime @default(now())

  menuItem      MenuItem          @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifierGroup MenuModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, modifierGroupId])
  @@index([menuItemId])
  @@map("menu_item_modifier_groups")
}

// ---------------------------------------------------------------------------
// Phase 3 — Reservations
// ---------------------------------------------------------------------------
//
// Deviations from the spec's literal table list (documented, not silent):
//
// 1. No separate `reservation_guests` table. Guest contact info is stored
//    directly on `Reservation` (guestName/guestEmail/guestPhone) as a
//    snapshot at booking time, alongside an optional `customerUserId` for
//    registered accounts. A full CRM guest/customer profile (history,
//    preferences, tags, RFM segmentation) is Phase 8 — building a real
//    `customers` table now, before CRM exists to populate/use it, would mean
//    either leaving it empty or half-implementing Phase 8 early. The
//    snapshot fields are enough for staff to run service today; Phase 8 can
//    backfill a `Customer` link onto `Reservation` without a breaking change.
// 2. No separate `reservation_payments` table. `depositRequired`,
//    `depositAmount`, `depositStatus`, and `depositNote` live directly on
//    `Reservation`. Deposits in this phase are recorded manually by staff
//    (e.g. "cash received, ₱500, confirmed by phone") — there is no payment
//    gateway integration yet (see docs/architecture.md § Risks). A real
//    `payments`/`payment_transactions` ledger arrives with Phase 4
//    (order payments) and Phase 10 (accounting); wiring reservation deposits
//    into it happens then, not with a placeholder table now.
//
// Double-booking prevention: enforced by Postgres itself, not just
// application logic. `ReservationTable` denormalizes `startAt`/`endAt`/
// `status` from the parent `Reservation` (kept in sync by
// `ReservationService` inside the same transaction) specifically so a
// Postgres `EXCLUDE` constraint can reject overlapping bookings of the same
// table at the database level. Prisma's schema DSL has no first-class
// support for EXCLUDE constraints, so it is NOT expressed here — it is
// hand-written directly into the migration SQL
// (prisma/migrations/*_phase3_reservations/migration.sql):
//
//   CREATE EXTENSION IF NOT EXISTS btree_gist;
//   ALTER TABLE reservation_tables ADD CONSTRAINT no_double_booking
//     EXCLUDE USING gist ("tableId" WITH =, tsrange("startAt", "endAt") WITH &&)
//     WHERE (status NOT IN ('CANCELLED', 'NO_SHOW'));
//
// This means `prisma db pull` would not perfectly round-trip this table —
// documented here and in docs/database.md so it isn't mistaken for drift.

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ReservationDepositStatus {
  NONE
  PENDING
  PAID
  REFUNDED
}

model Reservation {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String
  // Optional: set when the reservation belongs to a registered account.
  // Always null for walk-in/phone bookings taken by staff.
  customerUserId String?

  // Contact snapshot at time of booking — always present, independent of
  // customerUserId, so staff never need a join to see who they're serving.
  guestName  String
  guestEmail String?
  guestPhone String?
  // Phase 8 — CRM. Optional link to the real Customer/CRM profile — see the
  // matching comment on Order.customerId.
  customerId String?

  startAt DateTime
  endAt   DateTime
  // Denormalized from startAt/endAt purely so party-size and time-window
  // queries can filter without a computed column; kept in sync by
  // ReservationService, never written independently.
  guestCount Int

  status            ReservationStatus @default(PENDING)
  specialRequests   String?
  occasion          String?

  // Deposits are manually recorded by staff in this phase — see file header.
  depositRequired Boolean                   @default(false)
  depositAmount   Decimal?                  @db.Decimal(10, 2)
  depositStatus   ReservationDepositStatus  @default(NONE)
  depositNote     String?

  cancellationReason String?
  cancelledAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer     User?                @relation(fields: [customerUserId], references: [id], onDelete: SetNull)
  crmCustomer  Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  tables       ReservationTable[]
  statusHistory ReservationStatusHistory[]
  reviews       CustomerReview[]
  orders       Order[]

  @@index([organizationId])
  @@index([branchId, startAt])
  @@index([customerUserId])
  @@map("reservations")
}

// Join table between Reservation and RestaurantTable. startAt/endAt/status
// are denormalized copies of the parent Reservation's fields (see file
// header) — required for the DB-level EXCLUDE constraint that prevents
// double-booking. ReservationService writes both the parent and this table
// in the same transaction, so they cannot drift.
model ReservationTable {
  id            String            @id @default(cuid())
  reservationId String
  tableId       String
  startAt       DateTime
  endAt         DateTime
  status        ReservationStatus
  createdAt     DateTime          @default(now())

  reservation Reservation     @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  table       RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  // Application-level guard (fast, in-process rejection of an obvious
  // duplicate link); the real double-booking guard is the DB EXCLUDE
  // constraint added in migration SQL, which also covers overlapping (not
  // just identical) time ranges.
  @@unique([reservationId, tableId])
  @@index([tableId])
  @@index([reservationId])
  @@map("reservation_tables")
}

model ReservationStatusHistory {
  id              String            @id @default(cuid())
  reservationId   String
  fromStatus      ReservationStatus?
  toStatus        ReservationStatus
  changedByUserId String?
  note            String?
  createdAt       DateTime          @default(now())

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId, createdAt])
  @@map("reservation_status_history")
}

// ---------------------------------------------------------------------------
// Phase 4 — Orders, Payments, Invoicing
// ---------------------------------------------------------------------------
//
// Deviations / notable decisions (documented, not silent):
//
// 1. Order items and modifiers SNAPSHOT their name/price at order time
//    (nameSnapshot, unitPriceSnapshot, priceDeltaSnapshot) rather than
//    living FKs into current menu state. Editing a menu item's price next
//    week must never rewrite what a customer was actually charged last
//    month — same immutability principle the accounting phase (10) will
//    depend on. The FK to the menu row is kept alongside the snapshot
//    purely for traceability ("which item was this"), with onDelete:
//    Restrict so a historical order can never be left dangling.
// 2. No separate `customers` table here either — same reasoning as
//    Reservation (see that model's header comment). Order carries an
//    optional `customerUserId` plus a guest contact snapshot.
// 3. No real payment gateway. `OrderPayment` is staff-recorded ("cash
//    received", "paid via GCash") — see `lib/payments/PaymentProvider.ts`
//    for the (currently unimplemented) seam a real provider will plug into.
// 4. Invoice numbering is sequential PER BRANCH (`InvoiceSequence`,
//    incremented atomically via upsert inside the same transaction that
//    creates the Invoice), matching how PH BIR-registered receipt series
//    are typically issued per point-of-sale. This is NOT yet
//    BIR-accredited official-receipt numbering — flagged in
//    docs/architecture.md § Risks for accountant sign-off before going live.
// 5. `invoices` has a partial unique index — "at most one non-VOID invoice
//    per order" — that has NO representation in Prisma's schema DSL
//    (partial/filtered unique indexes aren't expressible here, the same gap
//    as Phase 3's EXCLUDE constraint). It is hand-written directly into the
//    migration SQL (prisma/migrations/*_phase4_orders/migration.sql):
//
//      CREATE UNIQUE INDEX invoices_one_active_per_order
//        ON invoices ("orderId") WHERE (status != 'VOID');
//
//    `InvoiceService` also checks this in application code first (for a
//    clear error message), but the index is the real guarantee under a
//    race — verified with a concurrent test the same way Phase 3's
//    double-booking constraint was, just for "assign the next number
//    safely" instead of "reject an overlapping range."
//
// ---------------------------------------------------------------------------
// Phase 5 — Kitchen Display System
// ---------------------------------------------------------------------------
//
// The master spec's Kitchen Display section (§20) lists NO new tables — it
// asks for "a kitchen dashboard" where kitchen staff see new orders and move
// them through NEW → ACCEPTED → PREPARING → READY. That is deliberately NOT
// modeled as a second status enum here: it is the exact same lifecycle
// `OrderStatus` already implements (NEW=PENDING, ACCEPTED=CONFIRMED,
// PREPARING=PREPARING, READY=READY), just presented with kitchen-facing
// labels and filtered to the kitchen-relevant subset. `COMPLETED` (order
// picked up/served) and `CANCELLED` stay front-of-house/whole-order concerns
// already built in Phase 4 — the kitchen's job ends at READY. Building a
// parallel `KitchenTicketStatus` enum synced to `OrderStatus` would be two
// sources of truth for one state machine; `KitchenService` instead reads
// `Order`/`OrderItem` directly and delegates every transition back to
// `OrderService.updateStatus`, so the whitelisted transition table has
// exactly one implementation. The only new column is `Order.requiredAt`
// (see that field's comment above) for the spec's "Required time" — every
// other kitchen-board field (order number = `Order.id`, items, modifiers,
// special instructions = `Order.notes`/`OrderItem.notes`, table/order type,
// current status) already exists on `Order`/`OrderItem`.

enum OrderType {
  DINE_IN
  TAKEOUT
  DELIVERY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum OrderPaymentMethod {
  CASH
  CARD
  GCASH
  MAYA
  BANK_TRANSFER
  OTHER
}

enum OrderPaymentStatus {
  PENDING
  COMPLETED
  REFUNDED
}

enum InvoiceStatus {
  ISSUED
  VOID
}

model Order {
  id             String      @id @default(cuid())
  organizationId String
  branchId       String
  type           OrderType
  status         OrderStatus @default(PENDING)

  // Optional: registered account. Independent of the guest snapshot below,
  // same pattern as Reservation.
  customerUserId String?
  guestName      String?
  guestPhone     String?
  guestEmail     String?
  // Phase 8 — CRM. Optional link to the real Customer/CRM profile, distinct
  // from customerUserId (a login account) — a guest with no account can
  // still have a Customer profile staff created/matched at order time. Not
  // auto-matched from guest contact fields; the caller supplies it
  // explicitly (see CustomerService and the "Phase 8 — CRM" comment block).
  customerId String?

  // DINE_IN: tableId identifies where the order is being served; a walk-in
  // dine-in order may or may not trace back to a reservationId.
  tableId       String?
  reservationId String?
  // DELIVERY only — validated at the Zod layer, not the DB, same approach
  // as Reservation's business-hours check.
  deliveryAddress String?

  // Always server-computed from the current menu at order time — see
  // OrderService. Never trust a client-submitted total.
  subtotal      Decimal @db.Decimal(10, 2)
  taxTotal      Decimal @db.Decimal(10, 2)
  discountTotal Decimal @default(0) @db.Decimal(10, 2)
  // Phase 6 (Delivery) — snapshot of DeliveryZone.deliveryFee at order time,
  // included in `total` below. Lives here (not only on DeliveryOrder) so the
  // order's own total/payments/invoices are correct without every reader
  // needing to join to DeliveryOrder — see the "Phase 6 — Delivery" comment
  // block near DeliveryOrder for the full reasoning. Zero for non-delivery
  // orders and for delivery orders placed without a zone.
  deliveryFee Decimal @default(0) @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  notes              String?
  cancellationReason String?
  cancelledAt        DateTime?

  // Phase 5 (Kitchen Display System) — optional "have this ready by" time,
  // set at order creation (e.g. a delivery pickup window or a table's
  // requested timing). Null means "as soon as possible", the default for
  // most walk-in dine-in/take-out orders. Purely informational: it drives
  // the kitchen board's overdue indicator, it does not gate or auto-cancel
  // anything.
  requiredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer     User?            @relation(fields: [customerUserId], references: [id], onDelete: SetNull)
  crmCustomer  Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  table        RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  reservation  Reservation?     @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  payments      OrderPayment[]
  invoices      Invoice[]
  delivery      DeliveryOrder?
  reviews       CustomerReview[]
  // CAPP Phase 8 — Promotions. Set only when this order redeemed a
  // promo code/offer; see PromotionRedemption's own comment block.
  promotionRedemption PromotionRedemption?
  // CAPP Phase 10 — Loyalty. Not @unique: a single order can both earn
  // points (order-completion EARN) and, separately, be the order a
  // LOYALTY_REWARD promotion was redeemed against (REDEEM) — see
  // LoyaltyService for both write sites.
  loyaltyTransactions LoyaltyTransaction[]
  // CAPP Phase 10 — spec § 38 "Favorite orders."
  favoritedAsOrder    CustomerFavorite[]

  @@index([organizationId])
  // [branchId, createdAt] serves OrderService.list when status/type are
  // omitted (the common "all orders" board view); Phase 15 hardening adds
  // [branchId, status, createdAt] alongside it (not a replacement) for the
  // equally common status-filtered board queries (e.g. status: 'PENDING'),
  // which the 2-column index can't serve via a leftmost-prefix scan.
  @@index([branchId, createdAt])
  @@index([branchId, status, createdAt])
  @@index([customerUserId])
  @@index([customerId])
  @@index([tableId])
  @@map("orders")
}

model OrderItem {
  id                String  @id @default(cuid())
  orderId           String
  menuItemId        String
  menuItemVariantId String?

  nameSnapshot      String
  unitPriceSnapshot Decimal @db.Decimal(10, 2)
  quantity          Int
  lineSubtotal      Decimal @db.Decimal(10, 2)
  modifiersTotal    Decimal @default(0) @db.Decimal(10, 2)
  lineTotal         Decimal @db.Decimal(10, 2)
  notes             String?
  createdAt         DateTime @default(now())

  order     Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem  MenuItem            @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  variant   MenuItemVariant?    @relation(fields: [menuItemVariantId], references: [id], onDelete: Restrict)
  modifiers OrderItemModifier[]

  @@index([orderId])
  @@index([menuItemId])
  @@map("order_items")
}

model OrderItemModifier {
  id                 String   @id @default(cuid())
  orderItemId        String
  modifierId         String
  nameSnapshot       String
  priceDeltaSnapshot Decimal  @db.Decimal(10, 2)
  createdAt          DateTime @default(now())

  orderItem OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifier  MenuModifier @relation(fields: [modifierId], references: [id], onDelete: Restrict)

  @@index([orderItemId])
  @@map("order_item_modifiers")
}

model OrderStatusHistory {
  id              String       @id @default(cuid())
  orderId         String
  fromStatus      OrderStatus?
  toStatus        OrderStatus
  changedByUserId String?
  note            String?
  createdAt       DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model OrderPayment {
  id               String             @id @default(cuid())
  organizationId   String
  orderId          String
  method           OrderPaymentMethod
  amount           Decimal            @db.Decimal(10, 2)
  status           OrderPaymentStatus @default(COMPLETED)
  note             String?
  recordedByUserId String?
  createdAt        DateTime           @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_payments")
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  branchId       String
  orderId        String

  // Sequential per branch — see file header for the numbering scheme and
  // its (documented, hand-written) partial unique index.
  invoiceNumber String
  status        InvoiceStatus @default(ISSUED)

  subtotal      Decimal @db.Decimal(10, 2)
  taxTotal      Decimal @db.Decimal(10, 2)
  discountTotal Decimal @db.Decimal(10, 2)
  total         Decimal @db.Decimal(10, 2)

  issuedAt   DateTime  @default(now())
  voidedAt   DateTime?
  voidReason String?
  notes      String?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  items        InvoiceItem[]

  @@unique([branchId, invoiceNumber])
  @@index([organizationId])
  @@index([orderId])
  @@map("invoices")
}

model InvoiceItem {
  id                String  @id @default(cuid())
  invoiceId         String
  nameSnapshot      String
  unitPriceSnapshot Decimal @db.Decimal(10, 2)
  quantity          Int
  lineTotal         Decimal @db.Decimal(10, 2)
  // Flattened, human-readable modifier summary (e.g. "Extra Egg, Extra
  // Rice") rather than a further-nested modifier table — an invoice line is
  // a frozen historical snapshot, not a live editable structure.
  modifiersSummary String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model InvoiceSequence {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String   @unique
  lastNumber     Int      @default(0)
  updatedAt      DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("invoice_sequences")
}

// ---------------------------------------------------------------------------
// Phase 6 — Delivery
// ---------------------------------------------------------------------------
//
// Deviations / notable decisions (documented, not silent):
//
// 1. `DeliveryOrder` is a 1:1 COMPANION table to `Order`, not a merge of
//    delivery fields onto Order itself. The master spec lists it as its own
//    table (`delivery_orders`), and the reasoning holds up structurally too:
//    dine-in/take-out orders would otherwise carry a permanent block of
//    always-null delivery columns (zone, driver, pickup/delivery
//    timestamps, proof of delivery). `DeliveryOrder` is created
//    automatically, in the same transaction as the Order itself, whenever
//    `type = DELIVERY` — see OrderService.createOrder. The one exception is
//    `Order.deliveryFee`: that field DOES live on Order (see its own
//    comment above) because the fee has to be part of `Order.total` for
//    payments/invoices to be correct, and every reader of `Order.total`
//    would otherwise need to join to `DeliveryOrder` just to know if a fee
//    applies. `DeliveryOrder.deliveryFee` is a second snapshot of the exact
//    same value, kept for delivery-domain reporting — not a second source
//    of truth, both are written atomically in the same transaction.
// 2. `DeliveryOrder` has its OWN status lifecycle (`DeliveryStatus`),
//    deliberately NOT reusing `OrderStatus` the way Phase 5's kitchen board
//    reused it for the kitchen lifecycle. This is an intentional contrast:
//    Phase 5's NEW/ACCEPTED/PREPARING/READY genuinely IS the same lifecycle
//    as `OrderStatus`'s PENDING/CONFIRMED/PREPARING/READY (one order, one
//    kitchen ticket, one axis of progress). Delivery dispatch is a
//    different axis entirely — a driver can be ASSIGNED and en route to the
//    restaurant while the kitchen is still PREPARING, and the order isn't
//    DELIVERED until well after the kitchen already marked it READY.
//    Collapsing these into one enum would force illegal-looking states
//    (what does "order status = delivered" even mean while the kitchen
//    portion is a separate concept?) or silently drop information. Kept
//    fully decoupled: `DeliveryService` never writes `Order.status`, and
//    `OrderService` never writes `DeliveryOrder.status` — see
//    docs/architecture.md § 14 for the full reasoning, including why this
//    phase deliberately does NOT auto-complete the parent Order when a
//    delivery finishes (a debatable business call left to staff/managers
//    rather than silently automated).
// 3. `Driver` is a separate profile table, not just "a User with the DRIVER
//    role." The DRIVER role continues to gate authentication/authorization
//    (login, `delivery:manage` permission) exactly as it did from Phase 1 —
//    `Driver` adds the operational fields RBAC has no reason to carry
//    (vehicle info, phone, active/on-duty flag) and is what `DeliveryOrder`
//    actually assigns against. A user can hold the DRIVER role without (yet)
//    having a Driver profile — same "role grants capability, profile
//    carries domain data" split already used for Reservation/Order's
//    optional `customerUserId` link.
// 4. `DriverAssignment` is an APPEND-ONLY audit trail, separate from
//    `DeliveryOrder.driverId` (the current-state pointer used for fast
//    board queries) — same "denormalized current value + full history
//    table" pattern as `TableStatusHistory`/`OrderStatusHistory`, applied
//    here because reassignment (a driver backs out, gets swapped) is a
//    real, distinct event worth its own timestamped record, not just
//    another line in the generic status history.
// 5. No real navigation/maps/geocoding — `lib/notifications` and a maps
//    provider are still unconfigured (see docs/architecture.md § 7 Risks).
//    "Zone" is a plain named area staff define themselves (e.g. "North
//    District"), not a geofenced polygon. Proof of delivery is a staff
//    -entered text note + optional recipient name, not a photo — no object
//    storage is configured (see `.env.example`), same "no fake
//    integrations" rule Phase 4 applied to payments.

enum DeliveryStatus {
  UNASSIGNED
  ASSIGNED
  PICKED_UP
  DELIVERED
  FAILED
  CANCELLED
}

model DeliveryZone {
  id             String  @id @default(cuid())
  organizationId String
  branchId       String
  name           String
  description    String?
  deliveryFee    Decimal @default(0) @db.Decimal(10, 2)
  active         Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch         Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  deliveryOrders DeliveryOrder[]

  // Phase 15 hardening: partial unique index (WHERE active), hand-written
  // in the migration SQL — see TableSection's comment (line ~352) for the
  // full rationale. CREATE UNIQUE INDEX delivery_zones_branchId_name_active_key
  // ON delivery_zones ("branchId", "name") WHERE (active);
  @@index([organizationId])
  @@map("delivery_zones")
}

model Driver {
  id             String  @id @default(cuid())
  organizationId String
  branchId       String
  userId         String  @unique
  vehicleType    String?
  vehiclePlate   String?
  phone          String?
  active         Boolean @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries   DeliveryOrder[]
  assignments  DriverAssignment[]

  @@index([organizationId])
  @@index([branchId])
  @@map("drivers")
}

model DeliveryOrder {
  id             String         @id @default(cuid())
  organizationId String
  branchId       String
  orderId        String         @unique
  deliveryZoneId String?
  driverId       String?
  status         DeliveryStatus @default(UNASSIGNED)

  // Snapshot of DeliveryZone.deliveryFee at order time — see the module
  // header comment for why this duplicates (deliberately) Order.deliveryFee.
  deliveryFee Decimal @default(0) @db.Decimal(10, 2)

  estimatedDeliveryAt DateTime?
  pickedUpAt          DateTime?
  deliveredAt         DateTime?

  // Lightweight, staff/driver-entered proof of delivery — see module header
  // comment #5 for why this isn't a photo upload.
  proofOfDeliveryNote String?
  recipientName       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch        Branch                 @relation(fields: [branchId], references: [id], onDelete: Cascade)
  order         Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryZone  DeliveryZone?          @relation(fields: [deliveryZoneId], references: [id], onDelete: Restrict)
  driver        Driver?                @relation(fields: [driverId], references: [id], onDelete: SetNull)
  statusHistory DeliveryStatusHistory[]
  assignments   DriverAssignment[]

  @@index([organizationId])
  @@index([branchId, status])
  @@index([driverId])
  @@map("delivery_orders")
}

model DeliveryStatusHistory {
  id              String          @id @default(cuid())
  deliveryOrderId String
  fromStatus      DeliveryStatus?
  toStatus        DeliveryStatus
  changedByUserId String?
  note            String?
  createdAt       DateTime        @default(now())

  deliveryOrder DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)

  @@index([deliveryOrderId])
  @@map("delivery_status_history")
}

model DriverAssignment {
  id              String    @id @default(cuid())
  deliveryOrderId String
  driverId        String
  assignedByUserId String?
  assignedAt      DateTime  @default(now())
  // Set when this assignment is superseded (reassigned to another driver,
  // or the delivery is cancelled) — null means "currently active."
  unassignedAt    DateTime?
  note            String?

  deliveryOrder DeliveryOrder @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  driver        Driver        @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([deliveryOrderId])
  @@index([driverId])
  @@map("driver_assignments")
}

// ---------------------------------------------------------------------------
// Phase 7 — Catering
// ---------------------------------------------------------------------------
//
// Master spec §21-22 names all seven tables below explicitly and specifies
// the funnel: Inquiry -> Quote -> Accept -> Deposit -> Event -> Final
// payment. Five design decisions worth recording:
//
// 1. `CateringQuote` carries the fee breakdown the spec's quotation formula
//    requires (Food + Staffing + Equipment + Transportation + Setup +
//    Service Fees - Discounts + Taxes = TOTAL) as named Decimal columns,
//    not a generic "line items of arbitrary category" table. Only the food
//    portion gets real line items (`CateringQuoteItem`, mirroring
//    `OrderItem`) because that is the part with a genuine per-unit
//    breakdown (dish x quantity x price); staffing/equipment/transportation
//    /setup/service-fee are quoted as flat negotiated amounts in real
//    catering practice, not itemized against a fixed catalog this build
//    doesn't have (no staffing-rate-card or equipment-rental system
//    exists). `CateringQuote.total` is server-computed from these columns
//    by `CateringService`, the same "never trust a client-submitted total"
//    rule Phase 4 established for `Order`.
// 2. `CateringEvent` is a 1:1 companion to `CateringQuote` (`@unique
//    quoteId`), created automatically — in the same transaction as the
//    quote's ACCEPTED transition — exactly as master spec §22 states ("When
//    accepted, create the appropriate catering event"). Same reasoning as
//    Phase 6's `Order` -> `DeliveryOrder` split: an event only ever exists
//    for an accepted quote, so modeling it as a nullable set of columns on
//    `CateringQuote` itself would be equivalent but muddier, and a 1:1
//    table matches the master spec's own table list. `CateringEvent.total`
//    and `depositAmount` are snapshotted from the quote at accept time
//    (the same "menu prices can change later, order history shouldn't"
//    principle `OrderItem` established), and `CateringEventItem` rows are
//    snapshotted from `CateringQuoteItem` for the same reason.
// 3. `CateringPayment` is its own real table (as the master spec's table
//    list requires), not fields-on-the-row the way Phase 3 modeled
//    `Reservation`'s single deposit. Catering genuinely needs more than one
//    payment over the funnel's lifetime (a deposit, then a final balance
//    payment, sometimes more) — the same reason Phase 4 gave `Order` a real
//    `OrderPayment` table instead of a single field. `type` (DEPOSIT /
//    BALANCE) records which stage of the funnel a payment closes out;
//    `method`/`status` reuse the existing `OrderPaymentMethod`/
//    `OrderPaymentStatus` enums rather than duplicating them, because "how
//    was this paid" and "did it clear or get refunded" are domain concepts
//    independent of order vs. catering — one enum, two payment tables, not
//    two enums for the same real-world values.
// 4. `CateringInquiry`/`CateringEvent` use the same optional
//    `customerUserId` + guest-snapshot (`guestName`/`guestEmail`/
//    `guestPhone`) pattern `Order`/`Reservation` already established —
//    there is still no dedicated `customers` table (that is Phase 8's CRM
//    scope), so a catering customer is either a registered `User` or a
//    plain guest-contact snapshot, exactly like every other customer-facing
//    entity built so far.
// 5. No real e-signature, PDF quote generation, or customer self-service
//    portal — `CateringQuote.status` (DRAFT/SENT/VIEWED/ACCEPTED/REJECTED/
//    EXPIRED/CANCELLED) and its `sentAt`/`viewedAt`/`respondedAt`/
//    `expiresAt` timestamps are staff-recorded state transitions
//    (`CateringService`), not the product of an actual customer-facing
//    quote-viewing UI or e-signature integration — neither is configured
//    (see docs/architecture.md § 7 Risks). This mirrors Phase 4's "no
//    payment provider configured, payments are staff-recorded" stance
//    applied to the quoting funnel instead.

enum CateringInquiryStatus {
  NEW
  QUOTED
  CONVERTED
  CANCELLED
}

enum CateringQuoteStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum CateringEventStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum CateringPaymentType {
  DEPOSIT
  BALANCE
}

model CateringPackage {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String
  name           String
  description    String?
  pricePerGuest  Decimal  @db.Decimal(10, 2)
  minGuests      Int?
  maxGuests      Int?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  inquiries    CateringInquiry[]
  quotes       CateringQuote[]

  // Phase 15 hardening: partial unique index (WHERE active), hand-written
  // in the migration SQL — see TableSection's comment (line ~352) for the
  // full rationale. CREATE UNIQUE INDEX catering_packages_branchId_name_active_key
  // ON catering_packages ("branchId", "name") WHERE (active);
  @@index([organizationId])
  @@map("catering_packages")
}

model CateringInquiry {
  id             String                @id @default(cuid())
  organizationId String
  branchId       String

  // Optional registered account, independent of the guest snapshot below —
  // same pattern as Order/Reservation (see module header comment #4).
  customerUserId String?
  guestName      String?
  guestEmail     String?
  guestPhone     String?
  // Phase 8 — CRM. Optional link to the real Customer/CRM profile — see the
  // matching comment on Order.customerId.
  customerId String?

  eventType         String
  eventDate         DateTime
  location          String
  guestCount        Int
  packageId         String?
  menuRequirements  String?
  equipmentRequests String?
  staffRequests     String?
  setupRequests     String?
  deliveryRequested Boolean               @default(false)
  deliveryAddress   String?
  specialRequests   String?
  // CAPP Phase 6 — spec § 13's "BOOK CATERING" flow lists Budget as one of
  // the six fields a diner enters alongside event date/time/location/guest
  // count/event type/food preferences. Nullable/optional (like every other
  // free-form inquiry detail here) — a rough number the diner has in mind,
  // not a commitment; CateringService never uses it in pricing math, the
  // same way specialRequests is informational text staff read, not a
  // computed input.
  budget            Decimal?              @db.Decimal(10, 2)
  status            CateringInquiryStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer     User?            @relation(fields: [customerUserId], references: [id], onDelete: SetNull)
  crmCustomer  Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  package      CateringPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  quotes       CateringQuote[]

  @@index([organizationId])
  @@index([branchId, status])
  @@index([customerUserId])
  @@index([customerId])
  @@map("catering_inquiries")
}

model CateringQuote {
  id             String @id @default(cuid())
  organizationId String
  branchId       String
  inquiryId      String
  packageId      String?
  guestCount     Int

  // Server-computed by CateringService, mirroring the master spec's
  // quotation formula — see module header comment #1 for why only the food
  // portion (CateringQuoteItem) is itemized.
  foodTotal           Decimal @default(0) @db.Decimal(10, 2)
  staffingTotal       Decimal @default(0) @db.Decimal(10, 2)
  equipmentTotal      Decimal @default(0) @db.Decimal(10, 2)
  transportationTotal Decimal @default(0) @db.Decimal(10, 2)
  setupTotal          Decimal @default(0) @db.Decimal(10, 2)
  serviceFeeTotal     Decimal @default(0) @db.Decimal(10, 2)
  discountTotal       Decimal @default(0) @db.Decimal(10, 2)
  taxTotal            Decimal @default(0) @db.Decimal(10, 2)
  total               Decimal @default(0) @db.Decimal(10, 2)

  status             CateringQuoteStatus @default(DRAFT)
  sentAt             DateTime?
  viewedAt           DateTime?
  respondedAt        DateTime?
  expiresAt          DateTime?
  rejectionReason    String?
  cancellationReason String?
  // CAPP Phase 6 — spec § 13's "Request changes" customer action. There is
  // deliberately no CHANGES_REQUESTED entry in CateringQuoteStatus (see the
  // enum above) — a formal new state would ripple through
  // QUOTE_ALLOWED_TRANSITIONS and every staff view that reads quote status,
  // for something that is, in real catering practice, a message attached to
  // an otherwise-still-SENT-or-VIEWED quote, not a new lifecycle stage.
  // `CateringService.recordCustomerQuoteNote` writes here without touching
  // `status`; `respondedAt` is set the same way ACCEPTED/REJECTED already
  // set it, since "the customer responded" is true regardless of which of
  // the three responses it was.
  customerNote       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  inquiry      CateringInquiry     @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  package      CateringPackage?    @relation(fields: [packageId], references: [id], onDelete: SetNull)
  items        CateringQuoteItem[]
  event        CateringEvent?

  @@index([organizationId])
  @@index([branchId, status])
  @@index([inquiryId])
  @@map("catering_quotes")
}

model CateringQuoteItem {
  id          String  @id @default(cuid())
  quoteId     String
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(10, 2)
  lineTotal   Decimal @db.Decimal(10, 2)

  quote CateringQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("catering_quote_items")
}

model CateringEvent {
  id             String @id @default(cuid())
  organizationId String
  branchId       String
  quoteId        String @unique

  // Optional registered account, independent of the guest snapshot below —
  // same pattern as Order/Reservation (see module header comment #4).
  customerUserId String?
  guestName      String?
  guestEmail     String?
  guestPhone     String?
  // Phase 8 — CRM. Copied from CateringQuote.inquiry.customerId at
  // ACCEPTED-transition time — see CateringService.updateQuoteStatus. Not
  // directly settable by API input, same "snapshot, not live join" reasoning
  // as the other CateringEvent fields copied from the inquiry.
  customerId String?

  eventType  String
  eventDate  DateTime
  location   String
  guestCount Int
  status     CateringEventStatus @default(SCHEDULED)

  // Snapshotted from the accepted CateringQuote at creation time — see
  // module header comment #2 for why (menu/pricing can change later, event
  // history shouldn't).
  total         Decimal @db.Decimal(10, 2)
  depositAmount Decimal @default(0) @db.Decimal(10, 2)

  notes              String?
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  quote        CateringQuote       @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  customer     User?               @relation(fields: [customerUserId], references: [id], onDelete: SetNull)
  crmCustomer  Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items        CateringEventItem[]
  payments     CateringPayment[]
  reviews      CustomerReview[]

  @@index([organizationId])
  @@index([branchId, status])
  @@index([customerUserId])
  @@index([customerId])
  @@map("catering_events")
}

model CateringEventItem {
  id          String  @id @default(cuid())
  eventId     String
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  lineTotal   Decimal @db.Decimal(10, 2)

  event CateringEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("catering_event_items")
}

model CateringPayment {
  id             String              @id @default(cuid())
  organizationId String
  branchId       String
  eventId        String
  type           CateringPaymentType
  method         OrderPaymentMethod
  amount         Decimal             @db.Decimal(10, 2)
  status         OrderPaymentStatus  @default(COMPLETED)
  note           String?
  recordedByUserId String?
  createdAt      DateTime            @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  event        CateringEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([eventId])
  @@map("catering_payments")
}

// ---------------------------------------------------------------------------
// Phase 8 — CRM
// ---------------------------------------------------------------------------
//
// Master spec §9 names the table list (`customers`, `customer_addresses`,
// `customer_preferences`, `customer_notes`, `customer_tags`); §31 lists what
// to track (orders/reservations/catering counts, spend, average order value,
// first/last transaction, favorite products, visit frequency, lifetime
// value); §32 asks for RFM (Recency/Frequency/Monetary) segmentation into
// NEW/RETURNING/REGULAR/VIP/AT_RISK/INACTIVE/HIGH_VALUE with "configurable"
// thresholds. Phase 8's own build list additionally names "Reviews" with no
// field-level spec anywhere in the document — `CustomerReview` below is this
// build's own design, documented as such rather than presented as spec'd.
// Five design decisions worth recording:
//
// 1. `Customer` is a real profile table, deliberately separate from `User`
//    — the same "role/account grants capability, profile carries domain
//    data" split Phase 6 used for `Driver` vs. the DRIVER role. Most
//    restaurant customers are walk-ins or phone/guest orders who never
//    create a login account at all, so a CRM profile has to be able to
//    exist independently of one; `Customer.userId` (nullable, `@unique`) is
//    the optional link for the minority who do register. Per §9's literal
//    field list, `Customer` carries only `organizationId` — no `branchId` —
//    since a customer's relationship is with the restaurant business, not
//    one physical location; a customer who orders from Branch A and dines
//    at Branch B is still one customer.
// 2. To make "total orders / total spend / favorite products / last
//    transaction" genuinely queryable rather than fragile email-string
//    matching across guest checkouts, this phase adds a nullable
//    `customerId` column (`onDelete: SetNull`) to `Order`, `Reservation`,
//    and `CateringInquiry` — the relation field is named `crmCustomer` to
//    keep it visually distinct from each model's existing `customer` field
//    (the `User?` relation via `customerUserId`, an unrelated concept: "was
//    there a login account"). `CateringEvent.customerId` is the same idea
//    but is never set directly by API input — `CateringService` copies it
//    from `CateringQuote.inquiry.customerId` at the `ACCEPTED` transition,
//    the same "snapshot at accept-time" treatment already given to
//    `CateringEvent`'s guest-contact fields. None of this is auto-matched
//    from guest name/email/phone — staff explicitly attach a `Customer` via
//    the CRM UI (search-or-create), which is a deliberate scope boundary:
//    fuzzy customer-matching/de-duplication is a real feature with real
//    false-positive risk (merging two different people who share a phone
//    number), not built here.
// 3. `CustomerReview.rating` is enforced as an integer 1-5 by a hand-written
//    `CHECK` constraint in the migration (Prisma's schema DSL has no CHECK
//    support, the same gap Phase 3's `EXCLUDE` constraint and Phase 4's
//    partial unique index hit) in addition to the Zod-layer bound — the
//    database is the real guarantee, Zod is the friendly error message.
//    Every review in this build is `recordedByUserId`-attributed staff
//    entry, not a customer-submitted rating — there is no customer-facing
//    review form (see point 5).
// 4. RFM segmentation is computed on read, in `lib/crm/rfm.ts`
//    (`classifySegment`), never stored as a column on `Customer`. This
//    build has no background job scheduler (the same honest gap Phase 5's
//    kitchen board polls around, and Phase 14/Notifications hasn't been
//    built yet) — a stored `segment` column would silently go stale with
//    nothing to ever recompute it. Computing it live from `Order`/
//    `Reservation`/`CateringEvent` aggregates on every profile/list read is
//    the correct trade-off at this build's current scale, not a shortcut.
//    `Customer.status` (ACTIVE/INACTIVE/BLOCKED) is a different, orthogonal
//    concept — a staff-set administrative flag (e.g. "this guest is
//    banned"), not the computed analytics segment.
// 5. §32's "make thresholds configurable" is honored via
//    `Organization.crmSettings` (nullable `Json`), following the same
//    "JSON column, code supplies the default when null" pattern
//    `Branch.openingHours` already established in Phase 1 — not a new
//    dedicated settings table for a handful of numbers. `lib/crm/rfm.ts`
//    exports `DEFAULT_RFM_THRESHOLDS` and `resolveRfmThresholds(org)`,
//    which merges any `crmSettings.rfmThresholds` override over the
//    defaults, field by field.
// ---------------------------------------------------------------------------

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

model Customer {
  id             String         @id @default(cuid())
  organizationId String
  // Optional: set only when this customer also has a registered User
  // account. Independent of everything else here — see module header #1.
  userId         String?        @unique
  // CAPP Phase 1: optional link to a self-service CustomerAccount (the
  // customer mobile app's platform-wide login — see
  // docs/customer-app/architecture.md § 3–4). Same shape and same reasoning
  // as `userId` directly above: this Customer row is the per-restaurant CRM
  // profile and keeps working unchanged for staff-entered walk-in guests
  // with no account at all; this field is only set once a CustomerAccount
  // actually interacts with this specific restaurant
  // (CustomerAccountService.getOrCreateCustomerProfile links or creates the
  // row rather than requiring one to pre-exist).
  customerAccountId String?      @unique
  firstName      String
  lastName       String?
  email          String?
  phone          String?
  dateOfBirth    DateTime?
  status         CustomerStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerAccount CustomerAccount? @relation(fields: [customerAccountId], references: [id], onDelete: SetNull)
  addresses    CustomerAddress[]
  preferences  CustomerPreference[]
  notes        CustomerNote[]
  tags         CustomerTag[]
  reviews      CustomerReview[]
  orders       Order[]
  reservations Reservation[]
  cateringInquiries CateringInquiry[]
  cateringEvents    CateringEvent[]
  // CAPP Phase 8 — Promotions: this CRM profile's redemption ledger.
  // Redemptions are counted against this (org-scoped) id, not the
  // cross-org CustomerAccount id — see PromotionRedemption's own comment.
  promotionRedemptions PromotionRedemption[]

  @@index([organizationId])
  @@index([organizationId, email])
  @@index([organizationId, phone])
  @@map("customers")
}

model CustomerAddress {
  id         String   @id @default(cuid())
  customerId String
  // e.g. "Home", "Office" — free text, not an enum; addresses are for
  // delivery convenience, not a workflow with legal statuses.
  label      String?
  line1      String
  line2      String?
  city       String?
  province   String?
  postalCode String?
  country    String   @default("PH")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_addresses")
}

model CustomerPreference {
  id         String   @id @default(cuid())
  customerId String
  // Free-form key/value (e.g. key "dietary", value "vegetarian"; key
  // "seating", value "booth by the window") rather than a fixed set of
  // typed columns — the master spec names the table with no field list, and
  // a restaurant's meaningful preferences vary too much to hard-code.
  key        String
  value      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, key])
  @@map("customer_preferences")
}

model CustomerNote {
  id           String   @id @default(cuid())
  customerId   String
  authorUserId String?
  note         String
  createdAt    DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  author   User?    @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@map("customer_notes")
}

model CustomerTag {
  id              String   @id @default(cuid())
  customerId      String
  tag             String
  createdByUserId String?
  createdAt       DateTime @default(now())

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdBy User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([customerId, tag])
  @@map("customer_tags")
}

model CustomerReview {
  id               String   @id @default(cuid())
  organizationId   String
  branchId         String?
  customerId       String?
  orderId          String?
  reservationId    String?
  cateringEventId  String?
  // Bounded 1-5 by a hand-written CHECK constraint in the migration — see
  // module header #3.
  rating           Int
  comment          String?
  recordedByUserId String?
  createdAt        DateTime @default(now())

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch        Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  order         Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  reservation   Reservation?   @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  cateringEvent CateringEvent? @relation(fields: [cateringEventId], references: [id], onDelete: SetNull)
  recordedBy    User?          @relation(fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([customerId])
  @@index([orderId])
  @@index([reservationId])
  @@index([cateringEventId])
  @@map("customer_reviews")
}

// ---------------------------------------------------------------------------
// Phase 9 — Inventory
// ---------------------------------------------------------------------------
//
// Master spec §13 (Ingredients and Recipes) and §14 (Inventory) list two
// groups of tables; §37 asks for inventory to connect to financial
// accounting (deferred to Phase 10's real double-entry ledger — this phase
// only builds the inventory-side half: real quantity/cost tracking that a
// later AccountingService can post journal entries from).
//
// Design decisions:
//
// 1. Two scoping tiers, matching the split this schema already uses for
//    MenuItem (organization-scoped catalog) vs. RestaurantTable
//    (branch-scoped operational data). Unit/Ingredient/Recipe/RecipeItem
//    are catalog data — "what is Chicken, what unit do we track it in,
//    what does a Chicken Rice Meal require" is the same answer at every
//    branch. InventoryItem/InventoryTransaction/Supplier/PurchaseOrder/
//    StockCount/WasteRecord are branch-scoped operational data — how much
//    Chicken is actually on the shelf, and every movement of it, is a
//    per-location fact.
//
// 2. quantityOnHand is never written directly outside a transaction row.
//    Every InventoryService method that changes stock creates a matching
//    InventoryTransaction (append-only, never updated/deleted) inside the
//    same DB transaction as the InventoryItem.quantityOnHand update — the
//    literal "never silently alter inventory quantities... every
//    adjustment must have an audit trail" instruction from §14. All seven
//    spec'd transaction types are real, reachable code paths this phase:
//    PURCHASE (PO receiving), SALE_CONSUMPTION (recipe-based consumption
//    on order completion), WASTE (WasteRecord creation), ADJUSTMENT/RETURN
//    (InventoryService.recordAdjustment, a signed manual correction),
//    TRANSFER (InventoryService.transferStock, two linked rows across
//    branches), and COUNT_CORRECTION (StockCount completion, one row per
//    line with a nonzero variance). quantityOnHand is allowed to go
//    negative — blocking an order from completing, or a waste record from
//    being logged, because a stock ledger under-counts real inventory
//    would be worse than letting the ledger go negative until the next
//    stock count corrects it.
//
// 3. Unit conversion is a single-level chain, not a general graph. A
//    "base" unit has baseUnitId = null; a "derived" unit points at exactly
//    one base unit with a conversionFactor (how many of the derived unit
//    equal one base unit — e.g. Gram.conversionFactor = 1000 with
//    Gram.baseUnitId = Kilogram.id). A derived unit's own baseUnitId must
//    itself be a base unit (depth capped at 1) — enforced in
//    InventoryService, not the DB, the same "app enforces, DB allows"
//    tradeoff Phase 8's RFM threshold validation already uses. See
//    lib/inventory/units.ts for the pure conversion function this backs.
//    Deliberately not a full transitive unit graph — every real recipe
//    only ever needs "grams to kilograms" or "milliliters to liters", not
//    an open-ended conversion solver.
//
// 4. Recipe is keyed 1:1 to MenuItem (@unique menuItemId), not to
//    MenuItemVariant or MenuModifier. A "Large" variant using more
//    ingredients than the base item, or an "Extra Cheese" modifier
//    consuming its own stock, are real restaurant scenarios this phase
//    does not model — recipe quantities scale only by
//    OrderItem.quantity, not by which variant/modifiers were selected.
//    Documented as a scope boundary, not silently ignored: a restaurant
//    with meaningfully different variant recipes would need this
//    extended before its inventory numbers are trustworthy.
//
// 5. InventoryTransaction's reference to "what caused this" (an Order, a
//    PurchaseOrder, a StockCount) is a loose (referenceType, referenceId)
//    string pair, not five nullable foreign keys — Prisma's schema DSL has
//    no first-class polymorphic relation support, and this ledger is
//    written to by several unrelated tables. unitCostAtTime is a snapshot
//    (not a live join to Ingredient.costPerUnit) for the same reason
//    OrderItem snapshots menu prices: a later cost change must not rewrite
//    the historical COGS of an already-completed order.
//
// 6. No automatic InventoryItem creation when an Ingredient is added — a
//    restaurant may define an ingredient in its recipe catalog long before
//    stocking it at every branch (or ever, at some branches). Staff (or
//    PO receiving, which auto-creates the InventoryItem row it needs) opts
//    a branch into tracking a given ingredient explicitly.

model Unit {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  abbreviation   String
  // See module header #3. Null on a base unit; on a derived unit, points at
  // its single base and carries the conversion factor to it.
  baseUnitId       String?
  conversionFactor Decimal  @default(1) @db.Decimal(14, 6)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  baseUnit           Unit?               @relation("UnitConversion", fields: [baseUnitId], references: [id], onDelete: Restrict)
  derivedUnits       Unit[]              @relation("UnitConversion")
  ingredients        Ingredient[]
  recipeItems        RecipeItem[]
  purchaseOrderItems PurchaseOrderItem[]

  @@unique([organizationId, abbreviation])
  @@index([organizationId])
  @@map("units")
}

model Ingredient {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  stockUnitId    String
  // Cost per one stockUnit. Manually maintained, or refreshed from
  // InventoryService.receivePurchaseOrderItems (see that method for the
  // "last purchase cost wins" policy).
  costPerUnit    Decimal  @default(0) @db.Decimal(12, 4)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockUnit          Unit                @relation(fields: [stockUnitId], references: [id], onDelete: Restrict)
  recipeItems         RecipeItem[]
  inventoryItems      InventoryItem[]
  purchaseOrderItems  PurchaseOrderItem[]

  @@index([organizationId])
  @@map("ingredients")
}

model Recipe {
  id             String   @id @default(cuid())
  organizationId String
  menuItemId     String   @unique
  // Servings this recipe's listed RecipeItem quantities produce.
  // Consumption scales by (orderItem.quantity / yieldQuantity) — a
  // yieldQuantity of 1 (the default) means "these quantities are per single
  // serving," the common case.
  yieldQuantity  Decimal  @default(1) @db.Decimal(10, 2)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  menuItem     MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  items        RecipeItem[]

  @@index([organizationId])
  @@map("recipes")
}

model RecipeItem {
  id           String  @id @default(cuid())
  recipeId     String
  ingredientId String
  quantity     Decimal @db.Decimal(12, 4)
  unitId       String

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  unit       Unit       @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@unique([recipeId, ingredientId])
  @@index([recipeId])
  @@map("recipe_items")
}

enum InventoryTransactionType {
  PURCHASE
  SALE_CONSUMPTION
  WASTE
  ADJUSTMENT
  RETURN
  TRANSFER
  COUNT_CORRECTION
}

model InventoryItem {
  id             String   @id @default(cuid())
  organizationId String
  branchId       String
  ingredientId   String
  // The running balance — see module header #2 for how this is kept
  // honest. Allowed to go negative on purpose.
  quantityOnHand Decimal  @default(0) @db.Decimal(14, 4)
  // "Low Stock" / "Critical Stock" thresholds (owner dashboard terms from
  // the master spec's analytics section) — both nullable and independently
  // configurable per item; null means "no alerting configured for this
  // item yet."
  reorderPoint   Decimal? @db.Decimal(14, 4)
  criticalPoint  Decimal? @db.Decimal(14, 4)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch          Branch                 @relation(fields: [branchId], references: [id], onDelete: Cascade)
  ingredient      Ingredient             @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  transactions    InventoryTransaction[]
  stockCountItems StockCountItem[]
  wasteRecords    WasteRecord[]

  @@unique([branchId, ingredientId])
  @@index([organizationId])
  @@index([branchId])
  @@map("inventory_items")
}

model InventoryTransaction {
  id              String                   @id @default(cuid())
  organizationId  String
  branchId        String
  inventoryItemId String
  type            InventoryTransactionType
  // Signed: positive increases quantityOnHand, negative decreases it.
  quantityDelta   Decimal                  @db.Decimal(14, 4)
  // Running balance immediately after this row — see module header #2.
  quantityAfter   Decimal                  @db.Decimal(14, 4)
  // Snapshot cost per unit at transaction time — see module header #5.
  unitCostAtTime  Decimal?                 @db.Decimal(12, 4)
  referenceType   String?
  referenceId     String?
  note            String?
  recordedByUserId String?
  createdAt       DateTime                 @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch        Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  recordedBy    User?         @relation(fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([inventoryItemId, createdAt])
  @@index([referenceType, referenceId])
  @@map("inventory_transactions")
}

model Supplier {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  contactName    String?
  email          String?
  phone          String?
  address        String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]

  // Phase 15 hardening: partial unique index (WHERE active), hand-written
  // in the migration SQL — see TableSection's comment (line ~352) for the
  // full rationale. CREATE UNIQUE INDEX suppliers_organizationId_name_active_key
  // ON suppliers ("organizationId", "name") WHERE (active);
  @@index([organizationId])
  @@map("suppliers")
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id                 String              @id @default(cuid())
  organizationId     String
  branchId           String
  supplierId         String
  status             PurchaseOrderStatus @default(DRAFT)
  // Server-computed sum of item lineTotals — never accepted from the client.
  total              Decimal             @default(0) @db.Decimal(12, 2)
  expectedAt         DateTime?
  submittedAt        DateTime?
  receivedAt         DateTime?
  notes              String?
  cancellationReason String?
  createdByUserId    String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  supplier     Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy    User?               @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  items        PurchaseOrderItem[]

  @@index([organizationId])
  @@index([branchId])
  @@index([supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String  @id @default(cuid())
  purchaseOrderId  String
  ingredientId     String
  unitId           String
  quantityOrdered  Decimal @db.Decimal(14, 4)
  quantityReceived Decimal @default(0) @db.Decimal(14, 4)
  unitCost         Decimal @db.Decimal(12, 4)
  lineTotal        Decimal @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  ingredient    Ingredient    @relation(fields: [ingredientId], references: [id], onDelete: Restrict)
  unit          Unit          @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

enum StockCountStatus {
  OPEN
  COMPLETED
  CANCELLED
}

model StockCount {
  id               String           @id @default(cuid())
  organizationId   String
  branchId         String
  status           StockCountStatus @default(OPEN)
  notes            String?
  recordedByUserId String?
  completedAt      DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  recordedBy   User?            @relation(fields: [recordedByUserId], references: [id], onDelete: SetNull)
  items        StockCountItem[]

  @@index([organizationId])
  @@index([branchId])
  @@map("stock_counts")
}

model StockCountItem {
  id               String   @id @default(cuid())
  stockCountId     String
  inventoryItemId  String
  // Snapshot of InventoryItem.quantityOnHand when this line was opened, so
  // the variance always reflects "what we counted vs. what the ledger said
  // at count time," not a since-moved running balance.
  expectedQuantity Decimal  @db.Decimal(14, 4)
  countedQuantity  Decimal? @db.Decimal(14, 4)

  stockCount    StockCount    @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@unique([stockCountId, inventoryItemId])
  @@index([stockCountId])
  @@map("stock_count_items")
}

model WasteRecord {
  id               String   @id @default(cuid())
  organizationId   String
  branchId         String
  inventoryItemId  String
  quantity         Decimal  @db.Decimal(14, 4)
  reason           String
  recordedByUserId String?
  createdAt        DateTime @default(now())

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch        Branch        @relation(fields: [branchId], references: [id], onDelete: Restrict)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  recordedBy    User?         @relation(fields: [recordedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([branchId])
  @@map("waste_records")
}

// ---------------------------------------------------------------------------
// Phase 10 — Accounting
// ---------------------------------------------------------------------------
//
// Master spec §27 ("implement a proper double-entry accounting architecture
// ... each journal entry must balance ... do not allow a posted journal
// entry to be directly edited, use reversal/correction entries"), §28 (seed
// a configurable chart of accounts), §29/§37 (a financial transaction
// engine mapping real business events — sales, deposits, purchases,
// consumption, waste, expenses — to journal entries, deterministically, "AI
// must never directly invent accounting entries"), §23 (customer deposits
// are a liability until earned, not automatic revenue), §30 (expense
// tracking), §45 (a dedicated AccountingService), §49 (automated proof that
// SUM(DEBITS) = SUM(CREDITS)). Six design decisions:
//
// 1. `ChartOfAccount` is organization-scoped and seeded per-organization at
//    registration (`AuthService.register`, mirroring how Phase 1 seeds
//    default roles) rather than being a single global chart every tenant
//    shares — §28's "seed an initial configurable chart" plus §37's "all
//    rules must be configurable" both imply per-tenant control (a
//    restaurant might rename "Marketing" to something else, add a branch-
//    specific expense account, etc.), which a shared global chart can't
//    support. `AccountingService.ensureChartOfAccounts` is idempotent
//    (checks before creating) so it is also safely callable for an
//    organization that existed before this phase shipped — exactly the
//    demo seed org's situation, since it was created by Phase 1's seed
//    script long before `ChartOfAccount` existed.
// 2. The audit-trail discipline Phase 9 established for `InventoryItem.
//    quantityOnHand` — one code path writes it, always paired with a ledger
//    row — repeats here, one level up: a `JournalEntry`'s lines are never
//    updated once `status` moves to `POSTED` (application-enforced; there
//    is no "update journal entry lines" service method at all once posted,
//    the same "the guarantee is structural, not conventional" reasoning).
//    Correcting a posted entry means `AccountingService.reverseJournalEntry`
//    — a brand-new entry with every line's debit/credit swapped, referencing
//    the original via `reversalOfEntryId`. The original's own `status`
//    field does flip to `REVERSED` (a lifecycle marker, the same kind of
//    post-creation status change every other model in this codebase makes
//    freely — Order/Invoice/PurchaseOrder/etc.) but its `JournalEntryLine`
//    rows, the actual accounting content, are never touched.
// 3. `FinancialTransaction` is the idempotency/link layer master spec §47
//    calls for explicitly ("implement idempotency for ... financial
//    posting ... a repeated request must not accidentally create duplicate
//    ... journal entries"). Every automatic posting (order revenue, a
//    deposit, a PO receipt, waste, an approved expense) creates exactly one
//    `FinancialTransaction` alongside its `JournalEntry`, keyed by
//    `@@unique([referenceType, referenceId, type])` — a retried
//    "complete this order" call cannot double-post its revenue entry, a
//    second call simply finds the existing link and does nothing further.
//    This is also the honest place to note a real scope boundary: the
//    order/reservation/catering/inventory transitions that trigger these
//    postings are themselves already guarded against reentrancy by their
//    own state machines (e.g. `Order.status` can only leave `COMPLETED` to
//    nowhere — see `OrderService`'s `ALLOWED_TRANSITIONS`), so the unique
//    constraint here is defense-in-depth for a path that is not actually
//    reachable through this build's own API today, not a currently-
//    exploitable gap being left open.
// 4. Deposits are never posted straight to a revenue account — §23's
//    explicit rule. A reservation deposit or a catering `DEPOSIT` payment
//    posts Debit Cash / Credit "Customer Deposits" (a liability). Revenue
//    is recognized — Debit Customer Deposits / Credit the relevant revenue
//    account — only when the service is actually rendered: a `Reservation`
//    reaching `COMPLETED` (with a `PAID` deposit), or a catering
//    `BALANCE` payment being recorded (treated as "the event happened, the
//    customer settled the account, the full event total is now earned" —
//    simpler and more robust than trying to key revenue recognition off
//    `CateringEvent.status` and payment amounts independently, at the cost
//    of a documented simplification: revenue is recognized at final-payment
//    time, not exactly at event-completion time, if those two moments ever
//    diverge in a future workflow change). Both policies are flagged in
//    `CLAUDE.md` as exactly the kind of local accounting-policy decision
//    §68 asks to have reviewed by a real accountant, not silently assumed
//    correct.
// 5. `AccountingPeriod` is a plain calendar-month bucket, auto-created on
//    demand (`AccountingService.ensureOpenPeriodForDate`) the first time an
//    entry needs to post into a given month, rather than requiring an
//    accountant to pre-create periods by hand before any transaction can
//    happen. Closing a period (`closePeriod`) is a real, enforced gate: it
//    refuses if any `DRAFT` journal entry is dated inside that period
//    (nothing can be silently left half-posted when the books close), and
//    once `CLOSED`, no new or reversing entry may be dated inside it — a
//    correction to a closed period posts as a new entry in the current open
//    period instead, standard closed-period accounting practice.
// 6. `Vendor` (this phase, §30) and `Supplier` (Phase 9, §14) are kept as
//    two separate tables despite being structurally almost identical —
//    deliberately, not from a missed dedup opportunity. A `Supplier` sells
//    ingredients and is referenced by `PurchaseOrder`, which posts to
//    `Inventory`/`Accounts Payable`; a `Vendor` is billed for a general
//    business expense (rent, software, a marketing platform) and is
//    referenced by `Expense`, which posts to whatever account its
//    `ExpenseCategory` maps to. The master spec lists them as separate
//    concepts in separate sections (§14 vs. §30) with separate purposes,
//    and conflating them would blur "who do we buy ingredients from" with
//    "who do we pay for overhead" — a real distinction a restaurant owner
//    would expect kept apart, even though today's fields happen to match.

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  COGS
  EXPENSE
}

enum DebitCredit {
  DEBIT
  CREDIT
}

// Phase 11 — classifies a non-cash account for the Cash Flow Statement's
// direct method (see ReportingService.generateCashFlow's file-header
// comment for the full reasoning). Master spec §35 gives only the generic
// textbook categories with no restaurant-specific mapping, so this build
// stores the classification explicitly on the chart rather than guessing
// it from account type/name at report time.
enum CashFlowCategory {
  OPERATING
  INVESTING
  FINANCING
}

model ChartOfAccount {
  id             String      @id @default(cuid())
  organizationId String
  // Simple numeric-prefix scheme (1xxx assets, 2xxx liabilities, 3xxx
  // equity, 4xxx revenue, 5xxx COGS, 6xxx expenses) — not mandated by the
  // master spec, but a conventional, sortable code every seeded account
  // gets so the chart reads in a sensible order.
  code           String
  name           String
  type           AccountType
  // Which side increases this account's balance — derivable from `type`
  // (ASSET/COGS/EXPENSE = DEBIT, LIABILITY/EQUITY/REVENUE = CREDIT) but
  // stored explicitly so balance/trial-balance queries never need a
  // hardcoded type→side switch statement scattered through the service.
  normalBalance  DebitCredit
  description    String?
  // Seeded default accounts (see AccountingService.ensureChartOfAccounts).
  // Not a delete-protection flag at the DB level (RESTRICT on
  // JournalEntryLine.accountId already prevents deleting any account with
  // postings) — purely informational, so the UI can visually distinguish
  // "part of the standard chart" from an org's own custom accounts.
  isSystem       Boolean     @default(true)
  active         Boolean     @default(true)
  // Phase 11 — true only for the accounts that actually represent cash on
  // hand or in the bank (the seeded chart's Cash/Bank accounts). Marks
  // which accounts generateCashFlow treats as "cash" for its direct-method
  // walk and for the dashboard's Cash Position figure — deliberately a
  // flag rather than an inferred "name contains 'Cash'" check, since a
  // custom account an org adds later has no name convention to rely on.
  isCashEquivalent  Boolean            @default(false)
  // Phase 11 — which of the Cash Flow Statement's three activity buckets
  // this account's postings belong to when they're the *contra* side of a
  // cash movement. Null for cash-equivalent accounts themselves (they
  // don't classify against themselves) and for accounts that never touch
  // cash directly. See ReportingService.generateCashFlow.
  cashFlowCategory  CashFlowCategory?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines              JournalEntryLine[]
  expenseCategories  ExpenseCategory[]

  @@unique([organizationId, code])
  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("chart_of_accounts")
}

enum AccountingPeriodStatus {
  OPEN
  CLOSED
}

model AccountingPeriod {
  id             String                 @id @default(cuid())
  organizationId String
  // Calendar-month bucket — startDate is always the 1st, endDate the last
  // instant of the month. See file header decision #5.
  startDate      DateTime
  endDate        DateTime
  status         AccountingPeriodStatus @default(OPEN)
  closedAt       DateTime?
  closedByUserId String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  closedBy       User?          @relation(fields: [closedByUserId], references: [id], onDelete: SetNull)
  journalEntries JournalEntry[]

  @@unique([organizationId, startDate])
  @@index([organizationId])
  @@map("accounting_periods")
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  REVERSED
}

model JournalEntry {
  id             String             @id @default(cuid())
  organizationId String
  // Nullable — most entries are branch-scoped (they come from a branch-
  // scoped business event), but a manual org-level adjusting entry is a
  // real case this build supports without forcing an arbitrary branch pick.
  branchId       String?
  periodId       String
  entryDate      DateTime
  description    String
  // Loose link back to whatever business event produced this entry (an
  // Order, a Reservation, a PurchaseOrder, a WasteRecord, an Expense) —
  // same pattern as InventoryTransaction's referenceType/referenceId.
  referenceType  String?
  referenceId    String?
  status         JournalEntryStatus @default(DRAFT)
  // Set only on a reversal entry, pointing at the entry it reverses.
  // @unique enforces "an entry may be reversed at most once" — you cannot
  // reverse the same original twice.
  reversalOfEntryId String?         @unique
  postedAt          DateTime?
  postedByUserId     String?
  createdByUserId    String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  period       AccountingPeriod  @relation(fields: [periodId], references: [id], onDelete: Restrict)
  // Phase 15 hardening: was SetNull — deleting the original entry would
  // have silently detached its reversal, breaking the reversal audit
  // trail without any error. Journal entries are never hard-deleted by
  // any code path today, but the DB constraint should say so, not just
  // application convention.
  reversalOf   JournalEntry?     @relation("JournalEntryReversal", fields: [reversalOfEntryId], references: [id], onDelete: Restrict)
  reversedBy   JournalEntry?     @relation("JournalEntryReversal")
  postedBy     User?             @relation("JournalEntryPostedBy", fields: [postedByUserId], references: [id], onDelete: SetNull)
  createdBy    User?             @relation("JournalEntryCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  lines        JournalEntryLine[]
  financialTransaction FinancialTransaction?
  expense      Expense?

  @@index([organizationId])
  @@index([branchId])
  @@index([periodId])
  @@index([referenceType, referenceId])
  // Phase 15 hardening: AccountingService.listJournalEntries always filters
  // by organizationId and sorts/range-filters by entryDate — no prior index
  // covered entryDate at all, so that query fell back to a full org-scoped
  // scan plus sort.
  @@index([organizationId, entryDate])
  @@map("journal_entries")
}

model JournalEntryLine {
  id             String   @id @default(cuid())
  journalEntryId String
  accountId      String
  // Exactly one of debit/credit is positive, the other is exactly 0 — a
  // hand-written migration CHECK constraint enforces this at the database
  // level (Prisma's schema DSL has no CHECK support, the same gap Phase 3/
  // 4/8's CHECK constraints hit), backed by a matching Zod-layer bound.
  debit          Decimal  @default(0) @db.Decimal(14, 2)
  credit         Decimal  @default(0) @db.Decimal(14, 2)
  description    String?

  journalEntry JournalEntry   @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  account      ChartOfAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_entry_lines")
}

enum FinancialTransactionType {
  ORDER_REVENUE
  ORDER_COGS
  DEPOSIT_RECEIVED
  DEPOSIT_REFUNDED
  DEPOSIT_EARNED
  INVENTORY_PURCHASE
  INVENTORY_WASTE
  EXPENSE_POSTED
}

model FinancialTransaction {
  id             String                   @id @default(cuid())
  organizationId String
  branchId       String?
  type           FinancialTransactionType
  // What business event produced this posting — an Order, Reservation,
  // CateringPayment, PurchaseOrder, WasteRecord, or Expense id.
  referenceType  String
  referenceId    String
  journalEntryId String                   @unique
  createdAt      DateTime                 @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: Restrict)
  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  // The idempotency guard — see file header decision #3.
  @@unique([referenceType, referenceId, type])
  @@index([organizationId])
  @@map("financial_transactions")
}

model ExpenseCategory {
  id               String   @id @default(cuid())
  organizationId   String
  name             String
  // Which account an expense in this category posts to by default — see
  // file header decision #6 (kept separate from the seeded chart's fixed
  // account list so an org can add its own categories/accounts later).
  defaultAccountId String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  defaultAccount ChartOfAccount? @relation(fields: [defaultAccountId], references: [id], onDelete: SetNull)
  expenses       Expense[]

  // Phase 15 hardening: partial unique index (WHERE active), hand-written
  // in the migration SQL — see TableSection's comment (line ~352) for the
  // full rationale. CREATE UNIQUE INDEX expense_categories_organizationId_name_active_key
  // ON expense_categories ("organizationId", "name") WHERE (active);
  @@index([organizationId])
  @@map("expense_categories")
}

model Vendor {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  contactName    String?
  email          String?
  phone          String?
  address        String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenses     Expense[]

  // Phase 15 hardening: partial unique index (WHERE active), hand-written
  // in the migration SQL — see TableSection's comment (line ~352) for the
  // full rationale. CREATE UNIQUE INDEX vendors_organizationId_name_active_key
  // ON vendors ("organizationId", "name") WHERE (active);
  @@index([organizationId])
  @@map("vendors")
}

enum ExpenseApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Expense {
  id             String                 @id @default(cuid())
  organizationId String
  branchId       String
  vendorId       String?
  categoryId     String
  amount         Decimal                @db.Decimal(12, 2)
  expenseDate    DateTime
  // Reuses the existing OrderPaymentMethod enum — same "one enum, many
  // tables" reasoning Phase 7's CateringPayment already established for
  // OrderPaymentMethod/OrderPaymentStatus.
  paymentMethod    OrderPaymentMethod
  notes            String?
  approvalStatus   ExpenseApprovalStatus @default(PENDING)
  recordedByUserId String?
  approvedByUserId String?
  // Set only once APPROVED and posted — see AccountingService.approveExpense.
  journalEntryId   String?               @unique
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  vendor       Vendor?             @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  category     ExpenseCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  recordedBy   User?               @relation("ExpenseRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  approvedBy   User?               @relation("ExpenseApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  journalEntry JournalEntry?       @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  attachments  ExpenseAttachment[]

  @@index([organizationId])
  @@index([branchId])
  @@index([categoryId])
  @@map("expenses")
}

model ExpenseAttachment {
  id               String   @id @default(cuid())
  expenseId        String
  fileName         String
  // Metadata-only, same honest stub as the rest of this build's unconfigured
  // integrations (STORAGE_PROVIDER_KEY is unset per .env.example) — no real
  // file upload/storage exists yet, this records that a receipt exists and
  // where it would live once storage is configured.
  fileUrl          String
  uploadedByUserId String?
  createdAt        DateTime @default(now())

  expense    Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  uploadedBy User?   @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  @@index([expenseId])
  @@map("expense_attachments")
}

// ---------------------------------------------------------------------------
// Phase 14 — Notifications
// ---------------------------------------------------------------------------

// Master spec §40's own list, verbatim. Reminder-type entries
// (RESERVATION_REMINDER/DEPOSIT_REMINDER/CATERING_REMINDER/PAYMENT_REMINDER)
// are fully implemented as callable NotificationService methods but are not
// wired to any automatic trigger in this build — see NotificationService's
// class header for why (no scheduler/cron infrastructure exists in this
// codebase; a real deployment would call these from a scheduled job).
enum NotificationType {
  RESERVATION_CONFIRMATION
  RESERVATION_REMINDER
  DEPOSIT_REMINDER
  ORDER_CONFIRMATION
  ORDER_STATUS
  DELIVERY_UPDATE
  CATERING_QUOTATION
  CATERING_REMINDER
  PAYMENT_REMINDER
  INVOICE
  REVIEW_REQUEST
  // CAPP Phase 6 — acknowledges a diner's own submitted catering inquiry
  // (spec § 13's "BOOK CATERING"), the same "we got it" pattern
  // ORDER_CONFIRMATION already gives take-out/delivery orders at creation.
  // CateringService.createInquiry previously fired no notification at all.
  CATERING_INQUIRY_RECEIVED
}

// Master spec §40: "Support: Email, Push notifications, SMS if configured."
enum NotificationChannel {
  EMAIL
  SMS
  PUSH
}

enum NotificationStatus {
  // Provider accepted the send request.
  SENT
  // Provider was configured but the send attempt itself failed —
  // errorMessage carries the provider's error.
  FAILED
  // No provider is configured for this channel (lib/notifications/*Provider.ts
  // — matches the "Integration requires configuration" convention every
  // other unconfigured integration in this build follows).
  SKIPPED_NOT_CONFIGURED
  // A provider is configured, but the triggering record had no usable
  // recipient for this channel (e.g. no email on file for an EMAIL attempt).
  SKIPPED_NO_RECIPIENT
}

// One row per attempted send, one channel per row — a reservation
// confirmation that goes out over both email and SMS produces two rows, not
// one row with two statuses, so each channel's own delivery outcome is
// independently queryable/auditable. Every row is written regardless of
// outcome (including the two SKIPPED_* cases) — a silently-absent row would
// be indistinguishable from "NotificationService was never called at all",
// which defeats the point of having a notification history at all.
model Notification {
  id             String              @id @default(cuid())
  organizationId String
  branchId       String
  type           NotificationType
  channel        NotificationChannel
  status         NotificationStatus

  // Email address or phone number actually targeted; null for the
  // SKIPPED_NO_RECIPIENT case, where there was nothing to target.
  recipient String?
  // Email only; null for SMS/PUSH.
  subject   String?
  body      String

  // Loosely-typed link back to whatever triggered this notification
  // (e.g. "Reservation/<id>", "Order/<id>") — deliberately not a set of
  // nullable FK columns (one per possible entity type), the same
  // AuditLog.entityType/entityId pattern this codebase already established
  // in Phase 1 for exactly this "polymorphic reference" shape.
  relatedEntityType String?
  relatedEntityId   String?

  // Opaque provider-assigned id, set only on SENT — mirrors
  // PaymentIntentResult.providerReference's naming in lib/payments/PaymentProvider.ts.
  providerReference String?
  errorMessage      String?

  createdAt DateTime  @default(now())
  sentAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([organizationId, type])
  // Phase 15 hardening: replaced the old [organizationId, createdAt] index —
  // every real call site (NotificationService.list) filters by
  // organizationId AND branchId together, never organizationId alone, so a
  // 3-column index serves that query directly while still covering any
  // future organizationId-only lookup via the leftmost-prefix rule.
  @@index([organizationId, branchId, createdAt])
  @@index([relatedEntityType, relatedEntityId])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// CAPP Phase 1 — Customer mobile app: multi-tenant identity, branding,
// customer authentication, real-time event outbox.
//
// See docs/customer-app/architecture.md for the full design narrative. This
// is a SEPARATE initiative layered on top of the platform's own 16 phases —
// "CAPP" (Customer APP) prefixes distinguish its phases/migrations from the
// base platform's. Everything below is additive: no existing model's
// meaning changes, only new relations are added (see Organization.branding/
// realtimeEvents and Customer.customerAccountId above).
// ---------------------------------------------------------------------------

// Backs Organization.publicCode generation — a singleton row per named
// sequence, incremented atomically inside a transaction. Identical pattern
// to InvoiceSequence (Phase 4), generalized to a `name` key instead of being
// tied to one branch, since restaurant public codes are a platform-global
// sequence, not a per-branch one.
model PlatformSequence {
  id         String   @id @default(cuid())
  name       String   @unique
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@map("platform_sequences")
}

// One row per restaurant (Organization), holding everything spec § 4
// "Restaurant Branding" lists that isn't already a core Organization/Branch
// field. Nullable/optional throughout by design: a restaurant that hasn't
// configured branding yet must not break the customer app — every field
// here falls back to a documented default at the API layer (see
// services/customer/RestaurantDirectoryService.ts), the same
// "unconfigured is a valid, handled state" discipline this codebase applies
// to every provider seam, applied here to branding data instead of a
// provider.
model RestaurantBranding {
  id             String   @id @default(cuid())
  organizationId String   @unique
  logoUrl        String?
  coverImageUrl  String?
  // Hex colors (e.g. "#1E3A8A"), validated at the API layer (Zod), not the
  // DB — same division of responsibility as every other Zod-validated field
  // in this codebase (see lib/validation/*).
  primaryColor   String?
  secondaryColor String?
  accentColor    String?
  description    String?
  website        String?
  // { facebook?, instagram?, twitter?, tiktok?, ... } — free-form, since the
  // spec names "Social media" with no fixed platform list.
  socialLinks    Json?
  reservationPolicy String?
  cancellationPolicy String?
  deliveryPolicy     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("restaurant_branding")
}

enum CustomerAccountStatus {
  ACTIVE
  SUSPENDED
  // Spec § 7: "Account deletion request" — a request, not necessarily
  // immediate hard deletion (which would break FK'd order/reservation
  // history the restaurant's own financial/audit records still need — same
  // "deactivate, don't destroy financial history" rule Phase 15 enforced
  // for Branch). Handled as a status a staff/ops process actions, not an
  // automatic cascade.
  DELETION_REQUESTED
}

// The customer's platform-wide identity — deliberately separate from `User`
// (staff identity, org-scoped RBAC roles). See
// docs/customer-app/architecture.md § 3 for the full "why not reuse User"
// reasoning. One CustomerAccount can interact with many restaurants (many
// per-organization Customer CRM profiles link back to it via
// Customer.customerAccountId), matching the spec's one-app-many-restaurants
// discovery model (§ 5).
model CustomerAccount {
  id           String                 @id @default(cuid())
  email        String?                @unique
  mobile       String?                @unique
  passwordHash String?
  // Set only when signed up/linked via that provider — see
  // lib/customer-auth/OAuthProvider.ts (unconfigured seam this phase).
  googleId     String?                @unique
  appleId      String?                @unique
  firstName    String
  lastName     String?
  profilePhotoUrl String?
  dateOfBirth  DateTime?
  marketingOptIn Boolean              @default(false)
  termsAcceptedAt   DateTime?
  privacyAcceptedAt DateTime?
  status       CustomerAccountStatus  @default(ACTIVE)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  notificationPreference CustomerNotificationPreference?
  refreshTokens           CustomerRefreshToken[]
  customerProfiles        Customer[]
  // CAPP Phase 7 — the personal real-time events (own order/reservation/
  // catering updates) addressed to this account. See RealtimeEvent's own
  // comment block.
  realtimeEvents          RealtimeEvent[]
  // CAPP Phase 8 — Promotions: this account's claimed offers and the
  // campaign audiences it was ever materialized into.
  customerPromotions      CustomerPromotion[]
  campaignAudiences       CampaignAudience[]
  // CAPP Phase 9 — Notifications: this account's notification-center
  // history and its registered push-notification devices, if any.
  customerNotifications   CustomerNotification[]
  pushTokens              CustomerPushToken[]
  // CAPP Phase 10 — Loyalty (one LoyaltyAccount per organization this
  // account has ordered from — see LoyaltyAccount's own comment for why
  // that's org-scoped, unlike this account itself) and favorited menu
  // items/orders across every restaurant.
  loyaltyAccounts   LoyaltyAccount[]
  customerFavorites CustomerFavorite[]
  // CAPP Phase 11 — Analytics: this account's logged behavioral events
  // (nullable on the event itself since most event types can also fire
  // signed-out — see CustomerAnalyticsEvent's own comment).
  analyticsEvents   CustomerAnalyticsEvent[]

  // Spec § 6/§ 7: registration must support email OR mobile (not
  // necessarily both), but at least one identifier plus a password (or a
  // future OAuth id) is required — enforced at the service/validation layer
  // (lib/validation/customer-auth.ts), not expressible as a plain Prisma
  // constraint, so it's documented here rather than silently assumed.
  @@map("customer_accounts")
}

// Spec § 26/§ 40 "customer_notification_preferences" — explicit per-category,
// per-channel opt-ins/outs. Transactional categories (order/reservation/
// payment) are intentionally separate from marketing ones (promotional),
// per spec § 26's "Transactional notifications... must remain separate from
// marketing notifications" — a customer can opt out of promotions while
// still receiving their own order-status updates.
model CustomerNotificationPreference {
  id                String   @id @default(cuid())
  customerAccountId String   @unique
  allowPromotional      Boolean @default(true)
  allowOrderUpdates     Boolean @default(true)
  allowReservationUpdates Boolean @default(true)
  allowLoyalty          Boolean @default(true)
  allowCatering         Boolean @default(true)
  emailPromotions       Boolean @default(true)
  smsPromotions         Boolean @default(false)
  pushPromotions        Boolean @default(true)
  updatedAt         DateTime @updatedAt

  customerAccount CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  @@map("customer_notification_preferences")
}

// One row per issued refresh token (effectively one row per logged-in
// device/session) — never the token itself, only its hash (see
// docs/customer-app/architecture.md § 4), so a leaked database dump alone
// can't be replayed as a valid session, same principle as passwordHash.
// Powers both single-device logout (revoke one row) and spec § 7's
// "Logout all devices" (revoke every row for the account).
model CustomerRefreshToken {
  id                String    @id @default(cuid())
  customerAccountId String
  tokenHash         String    @unique
  deviceInfo        String?
  createdAt         DateTime  @default(now())
  expiresAt         DateTime
  revokedAt         DateTime?

  customerAccount CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  @@index([customerAccountId])
  @@map("customer_refresh_tokens")
}

// Append-only event outbox backing real-time sync (spec § 15/§ 43) — see
// docs/customer-app/architecture.md § 6 for the full "why outbox + SSE, not
// WebSockets" reasoning. Every mutating service call that matters to the
// customer app writes one row here in the SAME transaction as its primary
// write, so an event can never be lost to a gap between "the write
// committed" and "the event was published." `type` is a plain string (not a
// Prisma enum) so adding a new event type never requires a migration — see
// the catalog in docs/customer-app/architecture.md § 6.
model RealtimeEvent {
  id             String   @id @default(cuid())
  organizationId String
  type           String
  payload        Json
  createdAt      DateTime @default(now())

  // CAPP Phase 7: a personal event (e.g. OrderAccepted for one diner's own
  // order) sets this to the CustomerAccount it's addressed to, so the SSE
  // stream (app/api/v1/restaurants/[restaurantId]/events/stream) can filter
  // out other diners' events rather than broadcasting every order/
  // reservation/catering update org-wide. A broadcast event with no single
  // owner (MenuItemAvailabilityChanged) leaves this null — delivered to
  // every connected client, signed in or not. Staff-created records with no
  // linked CustomerAccount (walk-ins, phone bookings) also resolve to null
  // here — the event still gets recorded for the outbox's own sake, it just
  // has no app session to deliver it to.
  customerAccountId String?

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerAccount CustomerAccount? @relation(fields: [customerAccountId], references: [id], onDelete: SetNull)

  // The SSE stream's poll query is always "events for this org, addressed
  // to me or to nobody in particular, newer than the last one I already
  // sent" — this index serves that directly.
  @@index([organizationId, customerAccountId, createdAt])
  @@map("realtime_events")
}

// ============================================================================
// CAPP Phase 8 — Promotions: engine, targeting, campaign management,
// redemption (spec § 16-32). Schema shape was pre-agreed in
// docs/customer-app/architecture.md § 5 back in Phase 1 (per spec § 68's
// "design the schema before building" First Action); this is where it's
// actually built. See architecture.md § 17 for the full implementation
// record, including every scope decision (which discount types compute a
// real discount amount vs. are creatable-but-flagged, why redemption wires
// into orders only this phase, and the redemption-count/effective-status
// race-safety reasoning).
// ============================================================================

// Matches spec § 18 exactly. PERCENTAGE/FIXED_AMOUNT/FREE_DELIVERY/
// CATERING_DISCOUNT/RESERVATION_DISCOUNT/FIRST_ORDER/REPEAT_CUSTOMER/
// BIRTHDAY/CUSTOMER_SPECIFIC compute a real, order-math-backed discount
// amount at redemption time. BOGO/FREE_ITEM/BUNDLE/FREE_ADDON also compute a
// real amount, using the cheapest-eligible-item-price interpretation
// documented in PromotionService — a defensible, non-fake reading, not a
// full free-item-selection feature. LOYALTY_REWARD is real as of CAPP Phase
// 10: it deducts `Promotion.loyaltyPointsCost` points from the diner's
// LoyaltyAccount (see LoyaltyService.redeemPoints) in exchange for the same
// flat-`discountValue` treatment FIXED_AMOUNT gets — see
// PromotionService.computeDiscount and .assertTypeSpecificEligibility.
enum PromotionDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  BOGO
  FREE_ITEM
  BUNDLE
  FREE_DELIVERY
  FREE_ADDON
  CATERING_DISCOUNT
  RESERVATION_DISCOUNT
  LOYALTY_REWARD
  FIRST_ORDER
  REPEAT_CUSTOMER
  BIRTHDAY
  CUSTOMER_SPECIFIC
}

// Spec § 28's six campaign statuses, reused here for the promotion itself
// (a promotion has the exact same lifecycle as its own default/implicit
// campaign — see PromotionService's header comment for why one enum serves
// both rather than duplicating it). ACTIVE/PAUSED/CANCELLED are staff-set;
// SCHEDULED/ACTIVE/ENDED beyond that are date-derived at read time (no
// background scheduler in this build — same "no separate always-on process"
// constraint Phase 7's real-time design already documented) via
// PromotionService.deriveEffectiveStatus. DRAFT means "not yet visible to
// any customer," regardless of dates.
enum PromotionStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  ENDED
  CANCELLED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

// Matches spec § 19 exactly. See AudienceResolver's RESOLVERS table for how
// each type is answered from existing data — LOYALTY_TIER (CAPP Phase 10)
// matches `audienceParams.tier` against LoyaltyAccount.tier.
enum PromotionAudienceType {
  ALL
  NEW
  RETURNING
  LOYAL
  INACTIVE
  ORDERED_ITEMS
  MADE_RESERVATIONS
  ORDERED_DELIVERY
  ORDERED_TAKEOUT
  BOOKED_CATERING
  INACTIVE_DAYS
  LOCATION
  LOYALTY_TIER
  SEGMENT
}

// Spec § 24's claim lifecycle. AVAILABLE/CLAIMED are the "save/claim an
// offer" states from the in-app promotion center; REDEEMED is terminal for a
// single-use promotion, or cycles back to CLAIMED (not AVAILABLE — it was
// already claimed) for a promotion whose customerUsageLimit allows more than
// one redemption — see PromotionService.recordRedemption's comment block.
enum CustomerPromotionStatus {
  AVAILABLE
  CLAIMED
  REDEEMED
  EXPIRED
}

// Restaurant-authored promotion, spec § 17-18. Org-scoped, not branch-scoped
// (like CateringPackage/Customer) — a promotion is a restaurant-wide offer,
// not tied to one physical location, matching how the customer app's single
// "restaurant" concept is Organization, not Branch (see architecture.md § 2).
model Promotion {
  id             String                @id @default(cuid())
  organizationId String
  title          String
  description    String?
  imageUrl       String?
  // Optional: a promotion redeemable only by entering this exact code at
  // checkout (spec § 17's "Promotion code"). Null for promotions that are
  // instead targeted/claimed through a campaign or the in-app promotion
  // center with no code to type. Unique per organization, not globally —
  // two different restaurants can both run a "WELCOME10" code.
  promoCode      String?
  discountType   PromotionDiscountType
  discountValue  Decimal               @db.Decimal(10, 2)
  minimumOrderValue Decimal?           @db.Decimal(10, 2)
  maximumDiscount   Decimal?           @db.Decimal(10, 2)
  startAt        DateTime
  endAt          DateTime?
  // Spec § 17's "Start time"/"End time" — an optional daily HH:MM window
  // (e.g. the "5:00 PM - 9:00 PM" happy-hour example in spec § 20),
  // evaluated against the customer's redemption-time local clock the same
  // way `lib/utils/business-hours.ts` already evaluates Branch.openingHours
  // — plain "HH:MM" strings, not a Prisma enum/time type, deliberately
  // reusing that existing convention instead of inventing a new one.
  startTimeOfDay String?
  endTimeOfDay   String?
  // Spec § 17's "Eligible services" — plain string array (OrderType values
  // plus 'RESERVATION'/'CATERING' for the two discount types that reference
  // those flows), stored as Json for the same "no migration to add a new
  // service type later" reasoning RealtimeEvent.type already uses.
  eligibleServices     Json     @default("[]")
  eligibleMenuItemIds  String[] @default([])
  eligibleCategoryIds  String[] @default([])
  usageLimit           Int?
  customerUsageLimit   Int?
  // CAPP Phase 10 — required, and only meaningful, when discountType is
  // LOYALTY_REWARD: the number of points `LoyaltyService.redeemPoints`
  // deducts from the diner's LoyaltyAccount when this promotion is
  // redeemed at checkout, in exchange for the flat `discountValue` pesos
  // off (same flat-amount reading FIXED_AMOUNT/BUNDLE/etc. already use —
  // see PromotionService.computeDiscount). Validated as required for this
  // one discount type at the Zod layer (lib/validation/promotion.ts),
  // same "not expressible as a plain Prisma constraint" note
  // minimumOrderValue's sibling fields already carry.
  loyaltyPointsCost    Int?
  // The one place this counter is ever written — see
  // PromotionService.recordRedemption's atomic-increment-then-check comment
  // for why this is race-safe without a DB-level CHECK constraint (Prisma
  // has no cross-column check-on-update support without raw SQL).
  redemptionCount      Int      @default(0)
  terms                String?
  status               PromotionStatus @default(DRAFT)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaigns           PromotionCampaign[]
  customerPromotions  CustomerPromotion[]
  redemptions         PromotionRedemption[]

  // promoCode lookup at checkout ("enter a promo code") is always scoped to
  // one organization — this composite index serves that directly. Not a
  // unique constraint: two DRAFT/CANCELLED promotions could plausibly reuse
  // a retired code without conflict, and a hard uniqueness rule isn't
  // something the spec asks for.
  @@index([organizationId, promoCode])
  @@index([organizationId, status])
  @@map("promotions")
}

// Spec § 28 "Promotional campaign management." A promotion can have zero
// campaigns (a pure promo-code-at-checkout offer with no targeted push) or
// several over time (e.g. re-sending the same promotion to a fresh
// "inactive 30 days" audience next month) — this is deliberately a separate
// model from Promotion, not a handful of columns on it, so that history.
model PromotionCampaign {
  id             String   @id @default(cuid())
  organizationId String
  promotionId    String
  name           String
  audienceType   PromotionAudienceType
  // Type-specific parameters the resolver table needs — e.g. `{ days: 30 }`
  // for INACTIVE_DAYS, `{ menuItemIds: [...] }` for ORDERED_ITEMS,
  // `{ segment: 'VIP' }` for SEGMENT. Validated per-type at the service
  // layer (lib/validation/promotion.ts can't express a discriminated shape
  // this cleanly against a fixed Prisma column set), not here.
  audienceParams Json?
  status         CampaignStatus @default(DRAFT)
  scheduledAt    DateTime?
  // Set when PromotionCampaignService.send actually materializes the
  // audience and marks the campaign ACTIVE — see that method's header for
  // why "sent" here means "audience resolved and recorded," not "push/
  // email/SMS actually dispatched" (CAPP Phase 9's job).
  sentAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  promotion    Promotion         @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  audience     CampaignAudience[]
  // CAPP Phase 9 — every CustomerNotification this campaign's own `send`
  // fanned out (see PromotionCampaignService.send), one per audience member.
  notifications CustomerNotification[]

  @@index([organizationId, status])
  @@index([promotionId])
  @@map("promotion_campaigns")
}

// The materialized result of a campaign's audience-targeting query at send
// time (architecture.md § 5's original design intent) — an auditable "who
// was actually eligible," not recomputed after the fact from data that may
// have since changed (a customer who unsubscribes tomorrow shouldn't rewrite
// yesterday's campaign record).
model CampaignAudience {
  id                String   @id @default(cuid())
  campaignId        String
  customerAccountId String
  // Why this customer matched (e.g. "INACTIVE: last order 42 days ago") —
  // human-readable, for the campaign's own audit trail, not machine-parsed.
  eligibilityReason String?
  createdAt         DateTime @default(now())

  campaign        PromotionCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customerAccount CustomerAccount   @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  @@unique([campaignId, customerAccountId])
  @@index([campaignId])
  @@map("campaign_audiences")
}

// Spec § 24 "Promotion claiming" — one row per (customer, promotion) pair,
// the in-app promotion center's "SAVE OFFER"/"CLAIM OFFER" record. Not
// created for every promo-code-at-checkout redemption — see
// PromotionService.recordRedemption's comment for when this is created
// lazily vs. required up front (CUSTOMER_SPECIFIC promotions require one to
// already exist, since that discount type is inherently pre-targeted).
model CustomerPromotion {
  id                String                   @id @default(cuid())
  customerAccountId String
  organizationId    String
  promotionId       String
  status            CustomerPromotionStatus  @default(AVAILABLE)
  claimedAt         DateTime?
  redeemedAt        DateTime?
  // Denormalized convenience counter for display ("used 2 of 3 times") —
  // PromotionRedemption remains the authoritative, append-only ledger this
  // is derived from, same relationship as Order.total being a stored
  // convenience value the OrderItem rows are the real source of truth for.
  timesRedeemed     Int                      @default(0)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  customerAccount CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  promotion       Promotion       @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([customerAccountId, promotionId])
  @@index([organizationId, customerAccountId])
  @@map("customer_promotions")
}

// Spec § 25 "Promotion redemption" — the authoritative, append-only record
// backing promotion analytics/ROI (spec § 29-30, CAPP Phase 11's job to
// surface). Written only from inside the same transaction as the order it
// discounted (or the deposit/payment, once reservation/catering redemption
// lands — see architecture.md § 17 for why that's out of this phase's
// scope), the same "outbox/ledger written in the same tx as the primary
// mutation" discipline this codebase already applies to RealtimeEvent and
// every financial ledger table.
model PromotionRedemption {
  id             String   @id @default(cuid())
  organizationId String
  promotionId    String
  customerId     String
  // Nullable/unique: set for the order-checkout redemption path this phase
  // builds. A future reservation/catering redemption path would add its own
  // nullable reservationId/cateringInquiryId column here rather than forcing
  // every redemption through Order.
  orderId        String?  @unique
  discountAmount Decimal  @db.Decimal(10, 2)
  redeemedAt     DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  promotion    Promotion    @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  order        Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([organizationId, promotionId])
  @@index([customerId, promotionId])
  @@map("promotion_redemptions")
}

// ============================================================================
// CAPP Phase 9 — Push/in-app notifications, notification center, anti-spam/
// opt-out (spec § 21-27, § 33-34, § 47-48, § 51). See architecture.md § 18.
// ============================================================================

enum CustomerNotificationCategory {
  ORDER
  RESERVATION
  PAYMENT
  PROMOTION
  LOYALTY
  CATERING
  SYSTEM
}

enum NotificationDeliveryChannel {
  PUSH
  EMAIL
  SMS
  IN_APP
}

enum NotificationDeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  OPENED
  FAILED
  UNSUBSCRIBED
  BOUNCED
}

// One row per device registered for push (spec § 47). Real token capture
// needs a native push SDK (expo-notifications) on the mobile side — this
// sandbox has no node_modules to install or verify a native module against,
// the same constraint that made CAPP Phase 7 hand-roll SSE over XHR instead
// of adding an unverifiable polyfill. Unlike that SSE case, there is no
// pure-JS workaround for a real APNs/FCM token, so this table, its
// registration endpoint, and NotificationDispatchService's consumption of
// it are all real — only the mobile call site that would populate it is a
// flagged, not-yet-built gap (see architecture.md § 18 and
// lib/notifications/PushProvider.ts's own header, which anticipated exactly
// this future phase).
model CustomerPushToken {
  id                String   @id @default(cuid())
  customerAccountId String
  token             String   @unique
  platform          String?
  createdAt         DateTime @default(now())
  lastSeenAt        DateTime @default(now())

  customerAccount CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  @@index([customerAccountId])
  @@map("customer_push_tokens")
}

// Spec § 27 "Notification Center" — the diner's persistent, in-app
// notification history. Distinct from RealtimeEvent (Phase 7's transient
// live-delivery outbox, tailed by SSE, never queried as a list) and from
// the base platform's own Notification model (Phase 14 — staff-triggered
// guest email/SMS, branch-scoped, no "read" concept). One row per
// notification-center entry; `NotificationCreated` (lib/realtime/emit.ts)
// fires alongside every insert so an already-open app updates its unread
// badge live over the same SSE connection Phase 7 already built.
model CustomerNotification {
  id                String                       @id @default(cuid())
  organizationId    String
  customerAccountId String
  category          CustomerNotificationCategory
  title             String
  message           String
  // In-app navigation target (e.g. "Orders"), NOT an OS-level universal/app
  // link — real OS deep linking (spec § 22's https://app.example.com/r/...
  // form) needs expo-linking config plus each restaurant's production
  // app-store identifiers, already flagged as an unbuilt Phase 2+ follow-up
  // in RestaurantContext.tsx since CAPP Phase 1. This reuses that same
  // honestly-open gap rather than pretending to close it — what's real here
  // is tapping a notification switching to the right tab in the already-
  // running app.
  deepLink          String?
  relatedEntityType String?
  relatedEntityId   String?
  // Set only for a campaign-originated (PROMOTION) notification — backs
  // both spec § 51's "do not send multiple promotional notifications for
  // the same campaign to the same customer" (the unique constraint below)
  // and spec § 28's "Notifications sent" campaign-level count.
  campaignId        String?
  isRead            Boolean                      @default(false)
  readAt            DateTime?
  createdAt         DateTime                     @default(now())

  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerAccount CustomerAccount        @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  campaign        PromotionCampaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  deliveries      NotificationDelivery[]

  // Postgres treats each NULL as distinct in a unique index, so this only
  // ever constrains campaign-originated rows (campaignId set) — every
  // transactional notification (campaignId null) is unaffected.
  @@unique([campaignId, customerAccountId])
  @@index([customerAccountId, isRead, createdAt])
  @@index([organizationId, createdAt])
  @@map("customer_notifications")
}

// Spec § 33 "Notification queue" / § 34 "Notification delivery status" —
// per-channel delivery tracking for a CustomerNotification, matching
// architecture.md § 5's original schema-preview description: a campaign
// notification fans out to multiple channels per customer, each with its
// own funnel (queued -> sent -> delivered -> opened, or failed/
// unsubscribed/bounced). IN_APP rows are written already DELIVERED — the
// CustomerNotification row's own existence *is* the in-app delivery, no
// external call needed. PUSH/EMAIL/SMS rows are written QUEUED and picked
// up by NotificationDispatchService.dispatchQueued, which this build has no
// scheduler to invoke automatically — the same "real interface, needs a
// future cron" gap already flagged for every reminder-type method on
// NotificationService since Phase 14.
model NotificationDelivery {
  id                     String                       @id @default(cuid())
  customerNotificationId String
  channel                NotificationDeliveryChannel
  status                 NotificationDeliveryStatus
  providerReference      String?
  errorMessage           String?
  queuedAt               DateTime                     @default(now())
  sentAt                 DateTime?
  deliveredAt            DateTime?
  openedAt               DateTime?
  failedAt               DateTime?

  customerNotification CustomerNotification @relation(fields: [customerNotificationId], references: [id], onDelete: Cascade)

  @@index([customerNotificationId])
  @@index([status, channel])
  @@map("notification_deliveries")
}

// ============================================================================
// CAPP Phase 10 — Loyalty, favorites, reordering, upselling (spec § 37-39).
// See architecture.md § 19 for the full implementation record.
// ============================================================================

// Points/rewards/tiers (spec § 37). BRONZE/SILVER/GOLD/PLATINUM is this
// build's own choice — the spec asks for "membership tiers" without naming
// them — configurable-by-threshold via lib/loyalty/loyalty-settings.ts, same
// "JSON column code supplies defaults for" pattern as
// lib/notifications/customer-app-settings.ts.
enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

// EARN (order completion, OrderService.updateStatus COMPLETED) and REDEEM
// (a LOYALTY_REWARD promotion, PromotionService.recordRedemption) are the
// two write paths this phase actually builds. EXPIRE/ADJUST are kept as
// real, valid states — matching architecture.md § 5's original preview and
// documenting the shape honestly — but nothing writes them yet: no points-
// expiry job exists (same no-scheduler constraint as
// NotificationDispatchService) and no staff manual-adjustment surface was
// built this phase (spec doesn't name one; flagged, not faked, same
// discipline as CAPP Phase 9's unbuilt push-token call site).
enum LoyaltyTransactionType {
  EARN
  REDEEM
  EXPIRE
  ADJUST
}

// One per (organization, customerAccountId) — spec § 37's "Restaurant-
// specific loyalty programs": points earned at one restaurant on this
// white-label platform must never be spendable at another, unlike
// CustomerNotificationPreference (deliberately account-wide, not
// org-scoped — see that model's own comment) or CustomerAccount itself.
model LoyaltyAccount {
  id                String      @id @default(cuid())
  organizationId    String
  customerAccountId String
  pointsBalance     Int         @default(0)
  // Never decremented by a redemption — only points actually expiring
  // would reduce this (not built; see LoyaltyTransactionType's comment).
  // Tier is derived from this, not from pointsBalance, so redeeming points
  // for a reward can never demote a diner's tier — see
  // LoyaltyService.resolveTier.
  lifetimePoints    Int         @default(0)
  tier              LoyaltyTier @default(BRONZE)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerAccount CustomerAccount      @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  transactions    LoyaltyTransaction[]

  @@unique([organizationId, customerAccountId])
  @@map("loyalty_accounts")
}

// Append-only ledger, same "never mutate history, only add to it" shape as
// PromotionRedemption/InventoryTransaction. `points` is signed (positive for
// EARN, negative for REDEEM/EXPIRE/ADJUST-down) so a single SUM(points)
// reconciles pointsBalance if it's ever in doubt.
model LoyaltyTransaction {
  id               String                 @id @default(cuid())
  loyaltyAccountId String
  type             LoyaltyTransactionType
  points           Int
  description      String?
  // Nullable: which order this was earned from (EARN) or spent against
  // (REDEEM) — see Order.loyaltyTransactions' own comment for why this
  // isn't @unique.
  relatedOrderId   String?
  createdAt        DateTime               @default(now())

  loyaltyAccount LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)
  relatedOrder   Order?         @relation(fields: [relatedOrderId], references: [id], onDelete: SetNull)

  @@index([loyaltyAccountId, createdAt])
  @@map("loyalty_transactions")
}

// Spec § 38 "Favorite orders" / "Favorite items", both on the single
// `customer_favorites` table the spec's own § 40 table list names — one
// nullable column per favoritable thing (menuItemId XOR orderId, enforced
// by a CHECK constraint in the migration — no Prisma DSL support for
// cross-column CHECKs, same gap Phase 3/4/8/10's other CHECK constraints
// hit) rather than either two separate tables or a polymorphic entityType
// string. Postgres treats each NULL in a unique index as distinct, so
// `@@unique([customerAccountId, menuItemId])` only actually constrains the
// non-null (favorite-item) rows and never conflicts with the (all-null-
// menuItemId) favorite-order rows, and vice versa — no special-casing
// needed.
model CustomerFavorite {
  id                String   @id @default(cuid())
  organizationId    String
  customerAccountId String
  menuItemId        String?
  orderId           String?
  createdAt         DateTime @default(now())

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerAccount CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  menuItem        MenuItem?       @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  order           Order?          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([customerAccountId, menuItemId])
  @@unique([customerAccountId, orderId])
  @@index([organizationId, customerAccountId])
  @@map("customer_favorites")
}

// Spec § 39 "Upselling" — "Restaurant controls the recommendation": a
// restaurant-authored pair (e.g. Burger -> Fries), surfaced by the customer
// app when the source item is viewed/added to cart (spec's own "Add Fries +
// Drink for ₱99" example). Self-referencing on MenuItem, so both FKs need
// their own named relation — `MenuItemRecommendationSource` for the item
// being viewed, `MenuItemRecommendationTarget` for the one being suggested.
// Staff-managed via MENU_MANAGE (reusing the existing menu-editing
// permission — this is menu configuration, not a new concern deserving its
// own permission) with no new dashboard page, same established "API +
// mobile app, no app/dashboard/** page" CAPP boundary every phase since 8
// has followed.
model MenuItemRecommendation {
  id                     String   @id @default(cuid())
  organizationId         String
  menuItemId             String
  recommendedMenuItemId  String
  // Restaurant-authored copy for the suggestion card, e.g. "Add Fries +
  // Drink for ₱99" — free text, not derived from the two item names, since
  // a bundle price/phrase doesn't follow mechanically from them.
  label                  String?
  // Optional combo price when bought together, distinct from the sum of
  // the two items' individual prices — null means "no special price, just
  // a suggestion." Purely informational to the mobile client; it does not
  // by itself create a redeemable discount (a restaurant wanting an actual
  // enforced bundle discount still creates a BUNDLE-type Promotion).
  bundlePrice            Decimal? @db.Decimal(10, 2)
  displayOrder           Int      @default(0)
  active                 Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  menuItem             MenuItem    @relation("MenuItemRecommendationSource", fields: [menuItemId], references: [id], onDelete: Cascade)
  recommendedMenuItem  MenuItem    @relation("MenuItemRecommendationTarget", fields: [recommendedMenuItemId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, recommendedMenuItemId])
  @@index([organizationId, menuItemId])
  @@map("menu_item_recommendations")
}

// CAPP Phase 11 — spec § 57 "Analytics." Six event types, deliberately not
// every funnel step spec § 57 lists — only the ones with no other
// authoritative row anywhere in this schema. "Order/Reservation started/
// completed" read from Order/Reservation's own createdAt/status;
// "Promotion claimed/redeemed" read from CustomerPromotion/
// PromotionRedemption; "Loyalty reward used" reads from LoyaltyTransaction
// (type REDEEM) — see PromotionAnalyticsService's header comment for the
// full table-by-funnel-step mapping. Logging those again here would be
// exactly the duplicate system the master spec's own build instructions
// ("do not create duplicate systems unnecessarily") warn against. What's
// left — app/restaurant/menu views, a promotion being viewed or tapped, and
// the "Order Again" tap specifically (indistinguishable from a fresh order
// once it becomes a real Order row) — has no other trace, so this table is
// the one genuinely new piece of Phase 11 infrastructure.
enum CustomerAnalyticsEventType {
  APP_OPENED
  RESTAURANT_VIEWED
  MENU_VIEWED
  PROMOTION_VIEWED
  PROMOTION_CLICKED
  REORDER_TAPPED
}

// Privacy-conscious by construction (spec § 57's own instruction): no IP
// address, device fingerprint, or location is ever stored, `customerAccountId`
// is nullable (every event type here can fire before a diner signs in — this
// app never gates browsing behind auth), and `menuItemId`/`promotionId` are
// plain loose references, not FKs — same "polymorphic-ish, display/analytics
// only" choice `CustomerNotification.relatedEntityId` already made, since
// which one (if either) is set depends on `eventType`. Best-effort writes —
// `CustomerAnalyticsService.logEvent` never runs inside another write's
// transaction and a failure here must never block the action being logged.
model CustomerAnalyticsEvent {
  id                String                     @id @default(cuid())
  organizationId    String
  customerAccountId String?
  eventType         CustomerAnalyticsEventType
  menuItemId        String?
  promotionId       String?
  createdAt         DateTime                   @default(now())

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerAccount CustomerAccount? @relation(fields: [customerAccountId], references: [id], onDelete: SetNull)

  @@index([organizationId, eventType, createdAt])
  @@index([customerAccountId, eventType])
  @@map("customer_analytics_events")
}

// ============================================================================
// Phase 17 — Platform Subscription Billing (SaaS Owner ⇄ Restaurant Owner)
// ============================================================================
//
// Everything above this line models a restaurant organization's OWN business
// (its menu, its orders, its diners). Everything below models a completely
// different relationship: the restaurant organization itself as a PAYING
// CUSTOMER of this SaaS platform, subscribing monthly for the right to use
// the software at all.
//
// That distinction forced two real architectural departures from every
// earlier phase:
//
// 1. A non-org-scoped admin actor. Every `User` in this schema belongs to
//    exactly one `organizationId` (see the User model above) — there is no
//    such thing as a staff account that spans organizations. But the "SaaS
//    Owner / Platform Administrator" the master spec describes manages
//    billing across ALL restaurant organizations at once, so it cannot be a
//    `User` + `Role` no matter how the RoleName enum is extended. `PlatformAdmin`
//    below is therefore a wholly separate authentication surface — its own
//    table, its own password hash, its own session secret
//    (`PLATFORM_ADMIN_AUTH_SECRET`, see lib/platform-admin/session.ts) — the
//    same "third distinct audience" move `CUSTOMER_AUTH_SECRET` already made
//    for the CAPP mobile app relative to staff `AUTH_SECRET` sessions.
//
// 2. Reuse the payment ABSTRACTION, not the payment TABLES. `lib/payments/
//    PaymentProvider.ts` (Phase 4) already abstracts "a PCI-compliant
//    gateway" for one-off order payments (diner → restaurant). Recurring
//    subscription billing (restaurant → platform) needs tokenized saved
//    payment methods, provider-side customers, and provider-side recurring
//    subscriptions — capabilities `PaymentProvider`'s
//    `createPaymentIntent`/`refund`/`verifyWebhookSignature` shape doesn't
//    cover. Rather than bend that interface to fit both very different money
//    flows, `lib/platform-billing/SubscriptionGatewayProvider.ts` is a
//    sibling interface following the exact same "real interface today, an
//    `Unconfigured*Provider` stub that fails loudly until a real gateway key
//    is set, provider swappable without touching call sites" pattern —
//    consistent with every other external integration in this codebase
//    (payments, SMS, email, storage, AI), not a special case.
//
// Every table below uses masked/display-only fields for anything
// settlement-related; the SaaS Owner's actual bank/merchant credentials are
// never modeled here at all — they live only in the payment provider's own
// dashboard and this app's environment variables (see .env.example's
// "Platform Subscription Billing" section), exactly as master spec §4/§53
// require ("do not hard-code the receiving account", "never expose to
// restaurant owners").

enum PlatformAdminStatus {
  ACTIVE
  DISABLED
}

// The SaaS Owner / Platform Administrator. Deliberately NOT a `User` — see
// the Phase 17 header comment above. Bootstrapped via `prisma/seed.ts` (dev)
// or a one-time setup script reading `PLATFORM_ADMIN_BOOTSTRAP_EMAIL` /
// `PLATFORM_ADMIN_BOOTSTRAP_PASSWORD` in production (see
// docs/deployment/production-checklist.md's Phase 17 addendum) — there is
// intentionally no public "register as a platform admin" endpoint anywhere.
// Phase 18 adds `role` for the master Data Analytics spec's admin RBAC
// matrix (SUPER_ADMIN/FINANCE_ADMIN/SUPPORT_ADMIN/SALES_ADMIN/
// ANALYTICS_ADMIN/DEVELOPER/AUDITOR — see `lib/platform-admin/rbac.ts`).
// Defaults to SUPER_ADMIN so every Phase 17 admin account (created before
// this concept existed, including the seeded bootstrap account) keeps its
// full original access after this migration rather than being silently
// locked out.
model PlatformAdmin {
  id           String               @id @default(cuid())
  email        String               @unique
  passwordHash String
  firstName    String
  lastName     String
  role         PlatformAdminRole    @default(SUPER_ADMIN)
  status       PlatformAdminStatus  @default(ACTIVE)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  auditLogs               PlatformAuditLog[]
  resolvedTasks            ActionCenterTask[]     @relation("ResolvedActionCenterTasks")
  assignedTasks            ActionCenterTask[]     @relation("AssignedActionCenterTasks")
  actionCenterNotes        ActionCenterNote[]
  issuedRefunds            PlatformRefund[]
  assignedComplaints       Complaint[]
  savedReports             SavedReport[]
  exportLogs               PlatformExportLog[]

  @@map("platform_admins")
}

enum SubscriptionPlanStatus {
  ACTIVE
  ARCHIVED
}

// Master spec §7: plans are SaaS-Owner-editable data, never hard-coded
// pricing in application source. `features`/`usageLimits` stay loosely-typed
// JSON (same "code supplies structure/defaults, table just stores it"
// choice Organization.crmSettings/aiSettings already made) since the spec
// never pins down a fixed feature-flag shape. `billingIntervalMonths` is a
// plain Int, not an enum restricted to "monthly" — master spec §1/§64
// explicitly require the interval stay configurable for future non-monthly
// plans without a schema migration.
model SubscriptionPlan {
  id                    String                  @id @default(cuid())
  planCode              String                  @unique
  name                  String
  description           String?
  monthlyPrice          Decimal                 @db.Decimal(10, 2)
  promoPrice            Decimal?                @db.Decimal(10, 2)
  promoValidUntil       DateTime?
  billingIntervalMonths Int                     @default(1)
  currency              String                  @default("PHP")
  features              Json
  usageLimits           Json?
  status                SubscriptionPlanStatus  @default(ACTIVE)
  displayOrder          Int                     @default(0)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  subscriptions Subscription[]

  @@index([status, displayOrder])
  @@map("subscription_plans")
}

enum BillingCustomerStatus {
  ACTIVE
  CLOSED
}

// One per Organization (at most) — the provider-side "customer" record a
// restaurant becomes the moment it first reaches Subscription Checkout.
// Holds only what master spec §17/§33 permit retaining locally
// (provider customer id, billing contact); the actual card data lives only
// at the payment provider, referenced via SubscriptionPaymentMethod below.
model BillingCustomer {
  id                 String                  @id @default(cuid())
  organizationId     String                  @unique
  paymentProvider    String
  providerCustomerId String
  billingEmail       String
  billingName        String
  currency           String                  @default("PHP")
  status             BillingCustomerStatus   @default(ACTIVE)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  organization   Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  paymentMethods SubscriptionPaymentMethod[]
  subscription   Subscription?

  @@unique([paymentProvider, providerCustomerId])
  @@map("billing_customers")
}

enum SubscriptionPaymentMethodStatus {
  ACTIVE
  EXPIRED
  REMOVED
}

// Tokenized payment-method REFERENCE only — master spec §10/§17 forbid
// storing full card number/CVV/PIN anywhere in this application, so none of
// those columns exist here even nullable. `type` stays a plain string
// (not an enum) since a future provider may add wallet/bank-debit types the
// spec doesn't enumerate; `isDefault` is a flag rather than a back-reference
// FK on BillingCustomer specifically to avoid a circular FK between these
// two tables (BillingCustomer already points at zero-or-more of these).
model SubscriptionPaymentMethod {
  id                      String                            @id @default(cuid())
  billingCustomerId       String
  provider                String
  providerPaymentMethodId String
  type                    String
  cardBrand               String?
  lastFour                String?
  expirationMonth         Int?
  expirationYear          Int?
  isDefault               Boolean                           @default(true)
  status                  SubscriptionPaymentMethodStatus    @default(ACTIVE)
  createdAt               DateTime                          @default(now())
  updatedAt               DateTime                          @updatedAt

  billingCustomer BillingCustomer @relation(fields: [billingCustomerId], references: [id], onDelete: Cascade)
  subscriptions   Subscription[]

  @@unique([provider, providerPaymentMethodId])
  @@index([billingCustomerId])
  @@map("subscription_payment_methods")
}

// Master spec §19/§22/§23: PAST_DUE covers both "an automatic retry is
// pending" AND "the configured grace period is running out" — modeled as
// one status with `nextRetryAt`/`gracePeriodEndsAt` timestamps rather than
// two separate statuses, since the spec's own diagram (§22) treats grace
// period as the tail end of the same failed-payment episode, not a
// distinct state a restaurant owner needs to tell apart from "retrying".
enum SubscriptionStatus {
  INCOMPLETE
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

// One per Organization (at most) — deliberately singular, not a history
// table. Each renewal updates this same row's currentPeriodStart/End and
// nextBillingDate in place; SubscriptionPayment/PlatformInvoice below are
// where the actual history lives (one row per billing cycle), the same
// "current state on the parent, history on child rows" split
// Reservation/ReservationDeposit already uses elsewhere in this schema.
model Subscription {
  id                     String              @id @default(cuid())
  organizationId         String              @unique
  planId                 String
  billingCustomerId      String              @unique
  paymentMethodId        String?
  status                 SubscriptionStatus  @default(INCOMPLETE)
  billingIntervalMonths  Int
  startDate              DateTime?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  nextBillingDate        DateTime?
  cancelledAt            DateTime?
  suspendedAt            DateTime?
  gracePeriodEndsAt      DateTime?
  nextRetryAt            DateTime?
  retryCount             Int                 @default(0)
  providerSubscriptionId String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  organization      Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan              SubscriptionPlan            @relation(fields: [planId], references: [id], onDelete: Restrict)
  billingCustomer   BillingCustomer             @relation(fields: [billingCustomerId], references: [id], onDelete: Restrict)
  paymentMethod     SubscriptionPaymentMethod?  @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  payments          SubscriptionPayment[]
  invoices          PlatformInvoice[]
  actionCenterTasks ActionCenterTask[]
  mrrMovementEvents MrrMovementEvent[]

  @@index([status])
  @@index([nextBillingDate])
  @@index([nextRetryAt])
  @@map("subscriptions")
}

enum SubscriptionPaymentStatus {
  INITIATED
  SUCCEEDED
  FAILED
  REFUNDED
}

// Master spec §31's `payments` table, field-for-field. One row per payment
// ATTEMPT (not per subscription) — a failed attempt followed by a
// successful retry is two rows, `paymentAttempt` numbering them, which is
// what lets PlatformInvoiceService/SubscriptionAnalyticsService reconstruct
// "how many attempts did this billing cycle take" without a separate event
// log.
model SubscriptionPayment {
  id                    String                      @id @default(cuid())
  organizationId        String
  subscriptionId        String
  paymentProvider       String
  providerCustomerId    String?
  providerPaymentId     String?
  providerTransactionId String?
  amount                Decimal                     @db.Decimal(10, 2)
  currency              String                      @default("PHP")
  status                SubscriptionPaymentStatus   @default(INITIATED)
  paymentMethodType     String?
  cardBrand             String?
  cardLastFour          String?
  billingPeriodStart    DateTime?
  billingPeriodEnd      DateTime?
  paymentAttempt        Int                         @default(1)
  failureCode           String?
  failureReason         String?
  paidAt                DateTime?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription      @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  invoice      PlatformInvoice?
  refunds      PlatformRefund[]
  disputes     PaymentDispute[]

  @@index([organizationId, createdAt])
  @@index([subscriptionId, status])
  @@index([providerTransactionId])
  @@map("subscription_payments")
}

enum PlatformInvoiceStatus {
  ISSUED
  VOID
}

// Master spec §34. Generated FROM a successful (or, for a due-but-unpaid
// cycle, pending) SubscriptionPayment — `paymentId` is nullable specifically
// to allow issuing an invoice before payment succeeds (spec §12 step order:
// invoice/receipt are generated as part of the payment-success sequence,
// but nothing here forbids a "PENDING" billing-period invoice existing
// first in a future dunning-email flow). Numbered via the same
// `PlatformSequence` atomic-upsert pattern `InvoiceSequence` uses for
// restaurant-facing invoices (see InvoiceService.issueInvoice) — this reuses
// `PlatformSequence` itself (already platform-wide, not per-branch) rather
// than adding a near-duplicate sequence table.
model PlatformInvoice {
  id                 String                  @id @default(cuid())
  invoiceNumber      String                  @unique
  organizationId     String
  subscriptionId     String
  paymentId          String?                 @unique
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  subtotal           Decimal                 @db.Decimal(10, 2)
  discount           Decimal                 @default(0) @db.Decimal(10, 2)
  tax                Decimal                 @default(0) @db.Decimal(10, 2)
  total              Decimal                 @db.Decimal(10, 2)
  currency           String                  @default("PHP")
  status             PlatformInvoiceStatus   @default(ISSUED)
  issuedAt           DateTime                @default(now())
  dueAt              DateTime?
  paidAt             DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription         @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  payment      SubscriptionPayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([organizationId, issuedAt])
  @@map("platform_invoices")
}

enum PlatformRefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

// Master spec §39. `administratorId` is required and NOT onDelete: Cascade
// (Restrict) — a refund record must never silently lose who authorized it
// even if that PlatformAdmin account is later removed; remove the admin
// account, not the accountability trail.
model PlatformRefund {
  id                String                @id @default(cuid())
  paymentId         String
  organizationId    String
  amount            Decimal               @db.Decimal(10, 2)
  reason            String
  administratorId   String
  providerReference String?
  status            PlatformRefundStatus  @default(PENDING)
  refundedAt        DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  payment       SubscriptionPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  administrator PlatformAdmin       @relation(fields: [administratorId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([paymentId])
  @@map("platform_refunds")
}

enum PaymentDisputeStatus {
  OPEN
  UNDER_REVIEW
  WON
  LOST
}

// Master spec §40 — tracked where the provider supports it; nothing in this
// codebase creates these directly (they arrive via `subscription.disputed`-
// style webhook events once a real gateway is configured), same "the seam
// exists, no fake data populates it" discipline as PaymentProvider itself.
model PaymentDispute {
  id                String                 @id @default(cuid())
  paymentId         String
  organizationId    String
  amount            Decimal                @db.Decimal(10, 2)
  reason            String?
  status            PaymentDisputeStatus   @default(OPEN)
  resolution        String?
  providerReference String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  payment      SubscriptionPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("payment_disputes")
}

// Master spec §37/§38 — webhook signature verification + idempotency.
// `@@unique([provider, providerEventId])` IS the idempotency guarantee:
// SubscriptionWebhookService inserts this row inside the same transaction
// as the state change a webhook causes, so a provider's at-least-once
// redelivery of the same event hits this unique constraint and is safely
// no-op'd rather than double-processed (double-activating a subscription,
// double-sending the owner SMS, etc.) — same pattern PromotionRedemption
// uses for redemption idempotency elsewhere in this schema.
model PlatformWebhookEvent {
  id              String    @id @default(cuid())
  provider        String
  providerEventId String
  type            String
  payload         Json
  processedAt     DateTime?
  processingError String?
  createdAt       DateTime  @default(now())

  @@unique([provider, providerEventId])
  @@index([type, createdAt])
  @@map("platform_webhook_events")
}

// Phase 18 widens this from a plain OPEN/RESOLVED toggle to the fuller
// lifecycle the Data Analytics & Action Center master spec's own §5
// requires (NEW/ACKNOWLEDGED/ASSIGNED/IN_PROGRESS/WAITING/
// FOLLOW_UP_REQUIRED/ESCALATED/RESOLVED/CLOSED/DISMISSED/CANCELLED).
// `OPEN` stays the default (unchanged from Phase 17, so every existing
// row and every existing `createTask` call site keeps working with no
// backfill) — `NEW` is available for callers that want to distinguish
// "just created, nobody has looked at it yet" from the generic OPEN state,
// but nothing requires using it. Values are only ever ADDED here, never
// removed or renamed, since Postgres enum values cannot be dropped without
// rebuilding the type.
enum ActionCenterTaskStatus {
  OPEN
  NEW
  ACKNOWLEDGED
  ASSIGNED
  IN_PROGRESS
  WAITING
  FOLLOW_UP_REQUIRED
  ESCALATED
  RESOLVED
  CLOSED
  DISMISSED
  CANCELLED
}

enum ActionPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// The master spec references "Action Center" ~15 times (§21/§23/§30/§40/
// §45/§50 among them) as though it already exists elsewhere in this
// codebase; it does not — `git grep`/schema search turn up nothing prior to
// this phase. This table is therefore the FIRST Action Center
// implementation, deliberately scoped to what Phase 17 itself needs
// (billing-triggered tasks only: failed/repeated-failed payment, upcoming
// suspension, payment recovered, dispute, refund, gateway/webhook failure,
// settlement discrepancy, subscription cancellation — master spec §45's
// list). `type` stays a plain string rather than an enum so a later phase
// (inventory low-stock, catering follow-up, etc.) can add its own task
// types without a migration touching this table. Two of master spec §45's
// items — "upcoming renewal" and "upcoming suspension" as PROACTIVE
// reminders fired ahead of the actual event — are NOT implemented here:
// they need a scheduled job evaluating "who renews/suspends in N days" on a
// timer, and this codebase has no background job runner/cron
// infrastructure anywhere (every other phase's "automatic" behavior is
// either request-triggered or webhook-triggered, never time-triggered).
// SubscriptionRetryService.runDueRetries — see that file's header — is
// built to be called BY such a scheduler once one exists; wiring an actual
// cron/queue is flagged here rather than silently stubbed.
// Phase 18 additions below `description` are all additive/nullable — every
// Phase 17 call site (`ActionCenterService.createTask`) still compiles and
// still produces a valid row without setting any of them. `priority`
// mirrors the master Data Analytics spec's Action Center §4/§7; scheduling
// fields (`dueAt` through `followUpMethod`) implement §31/§33; `complaintId`
// and `revenueImpact` implement §6's `complaint_id` and §47's "Revenue
// Impact"; `sourceModule` implements §6's `source_module` (which existing
// module raised this — 'billing', 'complaints', 'engagement', 'health',
// etc., a plain string for the same reason `type` is a plain string).
// Multi-entry timestamped notes (§35) live in the separate
// `ActionCenterNote` table below rather than a single text column, since
// the spec explicitly wants each note individually timestamped and
// attributed. `internalNotes`/`resolutionNotes` distinguish "notes taken
// along the way" (→ ActionCenterNote) from "the final resolution summary"
// (§51, a single required-in-spirit field on close) — kept as one column
// here since it is written once, at resolution.
model ActionCenterTask {
  id                String                   @id @default(cuid())
  type              String
  status            ActionCenterTaskStatus   @default(OPEN)
  priority          ActionPriority           @default(MEDIUM)
  organizationId    String?
  subscriptionId    String?
  complaintId       String?
  title             String
  description       String?
  sourceModule      String?
  revenueImpact     Decimal?                 @db.Decimal(10, 2)
  assignedToAdminId String?
  dueAt             DateTime?
  startedAt         DateTime?
  lastFollowUpAt    DateTime?
  nextFollowUpAt    DateTime?
  followUpMethod    String?
  resolutionNotes   String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  resolvedAt        DateTime?
  resolvedByAdminId String?
  closedAt          DateTime?

  organization    Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription    Subscription?   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  complaint       Complaint?      @relation(fields: [complaintId], references: [id], onDelete: SetNull)
  assignedAdmin   PlatformAdmin?  @relation("AssignedActionCenterTasks", fields: [assignedToAdminId], references: [id], onDelete: SetNull)
  resolvedByAdmin PlatformAdmin?  @relation("ResolvedActionCenterTasks", fields: [resolvedByAdminId], references: [id], onDelete: SetNull)
  notes           ActionCenterNote[]

  @@index([status, createdAt])
  @@index([organizationId])
  @@index([priority, status])
  @@index([assignedToAdminId, status])
  @@index([dueAt])
  @@map("action_center_tasks")
}

// Phase 18 — Data Analytics & Business Intelligence + Action Center Extension
// (master spec §36 "Action History" / §37 "Action Audit Trail"). Each row is
// one timestamped, attributed note — `writePlatformAuditLog` still records
// the coarser "who changed what field" audit trail; this table is the
// human-readable conversation log a support/finance/sales admin builds up
// while working an action ("Called owner. They requested payment on
// Friday.").
model ActionCenterNote {
  id             String        @id @default(cuid())
  taskId         String
  authorAdminId  String
  note           String
  createdAt      DateTime      @default(now())

  task   ActionCenterTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author PlatformAdmin    @relation(fields: [authorAdminId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@map("action_center_notes")
}

// Master spec §51's "all administrative actions must be recorded in an
// audit log" — a SEPARATE table from `AuditLog` above, not a reuse of it,
// because `AuditLog.organizationId` is required (every existing audit event
// happens inside one restaurant's context). A platform admin changing the
// global payment provider config or issuing a refund against organization A
// while logged in from no organization at all has no single required
// organizationId to hang that row off of — forcing it into `AuditLog` would
// mean either a fake/placeholder organizationId or making that column
// nullable for every OTHER phase's audit rows too. A parallel table with
// the identical shape (minus branchId, which has no platform-level
// equivalent) is the smaller, honest change.
model PlatformAuditLog {
  id              String    @id @default(cuid())
  platformAdminId String?
  action          String
  entityType      String
  entityId        String
  previousValue   Json?
  newValue        Json?
  ipAddress       String?
  createdAt       DateTime  @default(now())

  platformAdmin PlatformAdmin? @relation(fields: [platformAdminId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("platform_audit_logs")
}

enum PlatformBillingEnvironment {
  TEST
  LIVE
}

// Master spec §52's "SaaS Owner Billing Configuration" screen, persisted.
// Single row, always fetched/updated by the fixed id "singleton" —
// enforced by PlatformBillingConfigService, not a DB constraint (Prisma has
// no clean "exactly one row" constraint short of a raw partial-unique-index
// trick that would be more surprising than useful for one config row).
// IMPORTANT — what this table is NOT: it never stores the actual payment
// gateway secret key, webhook signing secret, or the SaaS Owner's real bank
// account number. Those live only in environment variables
// (SUBSCRIPTION_PAYMENT_PROVIDER_KEY, SUBSCRIPTION_PAYMENT_WEBHOOK_SECRET —
// see .env.example) and the payment provider's own merchant dashboard, per
// master spec §4/§53's explicit "never hard-code, never expose" rules. Every
// column here is either an operational flag (is a provider configured at
// all, is recurring billing on) or an already-masked display value
// (`settlementAccountLast4`, never the full number).
model PlatformBillingConfig {
  id                      String                      @id
  paymentProvider         String?
  environment             PlatformBillingEnvironment  @default(TEST)
  connectionStatus        String                      @default("NOT_CONNECTED")
  recurringBillingEnabled Boolean                     @default(false)
  webhookConfigured       Boolean                     @default(false)
  lastSuccessfulWebhookAt DateTime?
  lastFailedWebhookAt     DateTime?
  paymentTestStatus       String?
  settlementBankName      String?
  settlementAccountLast4  String?
  smsNotificationsEnabled Boolean                     @default(true)
  smsNotificationNumber   String?
  retryIntervalDays       Json                        @default("[3, 5, 7]")
  gracePeriodDays         Int                         @default(7)
  updatedAt               DateTime                    @updatedAt
  updatedByAdminId        String?

  @@map("platform_billing_config")
}

// ============================================================================
// Phase 18 — Data Analytics & Business Intelligence + Action Center Extension
// ============================================================================
//
// Source: "Master Prompt for Developers — Data Analytics" (87 sections) plus
// its embedded second document, "Developer / SaaS Owner Action Center —
// Intelligent Business Action & Follow-Up Management System" (71 sections).
// This is explicitly the SaaS PLATFORM's own admin-facing analytics/BI —
// NOT a restaurant owner's dashboard of their own business (that is
// `services/analytics/AnalyticsService.ts` and `services/reporting/
// ReportingService.ts`, both org-scoped and untouched by this phase). The
// spec repeats, twice, marked "VERY IMPORTANT": restaurant gross sales and
// SaaS subscription revenue must never be combined into one figure — see
// `PlatformAnalyticsService.ts`'s header for how that separation is
// enforced in code, not just in comments.
//
// Reconciliation decisions made against the existing Phase 17 schema
// (documented here once rather than repeated at every model below):
//   - `SubscriptionStatus` (INCOMPLETE/ACTIVE/PAST_DUE/SUSPENDED/CANCELLED)
//     is NOT replaced by the richer 10-state lifecycle this spec's §14
//     describes (…REGISTERED/ONBOARDING/TRIAL/…/REACTIVATED/EXPIRED). That
//     enum is a live, single-current-value state machine every billing
//     service already branches on; widening it risks breaking Phase 17
//     logic for states billing itself has no opinion about (ONBOARDING,
//     TRIAL are pre-subscription; REACTIVATED/EXPIRED are presentation
//     labels over states billing already tracks). Instead,
//     `RestaurantLifecycleEvent` below is an additive HISTORY log — every
//     transition a restaurant makes through the full spec lifecycle,
//     independent of (but written alongside) `Subscription.status` changes.
//   - `ActionCenterTask`/`ActionCenterService` (Phase 17) is EXTENDED, not
//     duplicated — see the widened `ActionCenterTaskStatus` enum and the
//     new columns on `ActionCenterTask` above. The spec's "Follow-Up
//     Management" system (§ own document, renewal/upgrade/downgrade/sales/
//     onboarding/inactive follow-ups) is implemented as a FILTERED VIEW over
//     this same table (see `TASK_TYPES` additions in `ActionCenterService.ts`
//     and `FollowUpService.ts`), not a second parallel task table — the
//     spec's own §60/§61 duplicate-prevention rules only make sense if
//     there is one task table to check against.
//   - `PlatformAdmin` gains `role` (this file, above) for the RBAC matrix —
//     see `lib/platform-admin/rbac.ts`.
//   - Complaints get a real, dedicated `Complaint` model (customer-facing
//     content, SLA, escalation — not something that fits inside an Action
//     Center task's generic `title`/`description`), with each complaint
//     auto-creating a linked `ActionCenterTask` (via `complaintId`).
//   - "Custom Report Builder" (§ dashboards) is intentionally NOT an
//     arbitrary-SQL/drag-and-drop query engine — `SavedReport.config` is a
//     constrained JSON shape (metric key + groupBy + date range + filters)
//     validated and executed by `ReportQueryService` against a fixed,
//     reviewed set of queryable metrics. An open query builder would be
//     both a security surface (tenant-isolation risk) and exactly the kind
//     of "unnecessary complexity for the initial deployment" §85 itself
//     warns against.
//   - Export formats: CSV and JSON are implemented for real. Excel/PDF
//     binary export are NOT — `PlatformExportLog.format` accepts them as a
//     value but `ExportService` throws a clear "not implemented" error for
//     them rather than silently emitting a fake file. Documented as a real
//     gap, same "no fake integrations" discipline as every unconfigured
//     provider in this codebase.

enum PlatformAdminRole {
  SUPER_ADMIN
  FINANCE_ADMIN
  SUPPORT_ADMIN
  SALES_ADMIN
  ANALYTICS_ADMIN
  DEVELOPER
  AUDITOR
}

// Master spec's Data Analytics document §14 lifecycle. One row per
// transition (not per restaurant) so the full history is preserved forever
// (§ "Retention" rule: never overwrite history) — `exitedAt`/`reason` on
// the PREVIOUS row are filled in when the NEXT transition is written,
// giving an exact duration per state without a separate computed table.
enum RestaurantLifecycleState {
  REGISTERED
  ONBOARDING
  TRIAL
  ACTIVE
  PAST_DUE
  GRACE_PERIOD
  SUSPENDED
  CANCELLED
  REACTIVATED
  EXPIRED
}

model RestaurantLifecycleEvent {
  id             String                     @id @default(cuid())
  organizationId String
  state          RestaurantLifecycleState
  enteredAt      DateTime                   @default(now())
  exitedAt       DateTime?
  reason         String?
  createdAt      DateTime                   @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, enteredAt])
  @@index([state, enteredAt])
  @@map("restaurant_lifecycle_events")
}

// Master spec's MRR movement breakdown (§ Revenue Analytics): every dollar
// of MRR change is attributed to exactly one of these five buckets, so
// `NET NEW MRR = NEW + EXPANSION + REACTIVATION - CONTRACTION - CHURNED`
// is a straight sum over one period's rows rather than a derived estimate.
// `previousPlanId`/`newPlanId` are deliberately plain strings, not FKs —
// same "loose reference for an optional, secondary field" choice
// `CustomerAnalyticsEvent.menuItemId`/`promotionId` already made elsewhere
// in this schema, avoiding two more named back-relations cluttering
// `SubscriptionPlan` for a field that is display-only.
enum MrrMovementType {
  NEW
  EXPANSION
  CONTRACTION
  CHURNED
  REACTIVATION
}

model MrrMovementEvent {
  id             String            @id @default(cuid())
  organizationId String
  subscriptionId String
  type           MrrMovementType
  amount         Decimal           @db.Decimal(10, 2)
  previousPlanId String?
  newPlanId      String?
  occurredAt     DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([organizationId, occurredAt])
  @@index([type, occurredAt])
  @@map("mrr_movement_events")
}

enum ComplaintCategory {
  BILLING
  TECHNICAL
  SERVICE_QUALITY
  FEATURE_REQUEST
  ACCOUNT
  OTHER
}

enum ComplaintPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ComplaintStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  ESCALATED
  RESOLVED
  CLOSED
}

// Master spec's Customer Support / Complaints module — a restaurant
// organization (the SaaS platform's paying customer) complaining TO the
// platform, e.g. about billing, a bug, or service quality. `raisedByUserId`
// is nullable because a complaint may arrive by phone/email and be logged
// by an admin on the restaurant's behalf, with no in-app account action
// involved. Every complaint gets a linked `ActionCenterTask`
// (ComplaintService creates both in one transaction) so it also surfaces in
// the unified Action Center queue per the spec's §20.
model Complaint {
  id                String             @id @default(cuid())
  organizationId    String
  raisedByUserId    String?
  category          ComplaintCategory
  priority          ComplaintPriority  @default(MEDIUM)
  status            ComplaintStatus    @default(NEW)
  subject           String
  description       String
  assignedToAdminId String?
  slaHours          Int                @default(24)
  escalatedAt       DateTime?
  resolvedAt        DateTime?
  resolutionNotes   String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  raisedByUser    User?               @relation(fields: [raisedByUserId], references: [id], onDelete: SetNull)
  assignedToAdmin PlatformAdmin?      @relation(fields: [assignedToAdminId], references: [id], onDelete: SetNull)
  actionCenterTasks ActionCenterTask[]

  @@index([organizationId, createdAt])
  @@index([status, priority])
  @@map("complaints")
}

enum PlatformHealthEventType {
  API_ERROR
  PAYMENT_GATEWAY_ERROR
  WEBHOOK_FAILURE
  NOTIFICATION_FAILURE
  DATABASE_ERROR
  APPLICATION_CRASH
  HIGH_LATENCY
  LOGIN_FAILURE
  INTEGRATION_FAILURE
}

enum PlatformHealthSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// Master spec's "Platform Health" / "System Alerts" module (§28/§29,
// Action Center §27-29). A real, append-only event log — NOT a fake APM
// integration. `PlatformHealthService.record()` is called from a small,
// honestly-scoped set of real trigger points already in this codebase
// (webhook processing failures, gateway call failures, login-rate-limit
// rejections — see that service's header for the exact list) rather than
// claiming coverage of "every possible error" across the whole app, which
// would require instrumenting every route handler and is out of scope for
// this phase.
model PlatformHealthEvent {
  id             String                    @id @default(cuid())
  type           PlatformHealthEventType
  severity       PlatformHealthSeverity
  message        String
  organizationId String?
  metadata       Json?
  resolvedAt     DateTime?
  createdAt      DateTime                  @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([type, createdAt])
  @@index([severity, createdAt])
  @@map("platform_health_events")
}

// Configurable alert thresholds (spec's "System Alerts" §). `metricKey` is
// a plain string key into a fixed catalog `PlatformAnalyticsService`
// exposes (e.g. "payment_failure_rate", "webhook_failure_count_1h") rather
// than an enum, so operators can be told which keys exist via the admin UI
// without a migration. Evaluating these against live metrics is a
// request-triggered check (`AnomalyDetectionService`), not a background
// timer — this codebase has no job scheduler (see the Phase 17 comment on
// `ActionCenterTask` for the same limitation already documented there).
model PlatformAlertRule {
  id                   String                    @id @default(cuid())
  name                 String
  metricKey            String
  comparisonOperator   String
  thresholdValue       Decimal                   @db.Decimal(12, 2)
  severity             PlatformHealthSeverity    @default(MEDIUM)
  enabled              Boolean                   @default(true)
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@map("platform_alert_rules")
}

// Master spec's standardized event-tracking system (§ "Data Foundation"):
// one row per named platform event (`restaurant.created`,
// `subscription.payment_succeeded`, `complaint.resolved`, `feature.used`,
// etc.). Only `organizationId` is a real FK (cascade — same choice
// `CustomerAnalyticsEvent` made for its own required-ish scoping field);
// `userId`/`subscriptionId`/`customerAccountId`/`planId`/`sessionId` are
// loose display-only references since which ones apply depends entirely on
// `eventType`, and this table is written best-effort, off the request path
// that triggered the underlying action — never inside its transaction — so
// a logging failure here must never roll back or block real work. Per the
// spec's own privacy rule, `metadata` must never carry raw PII beyond what
// each event's own defined shape documents.
model PlatformAnalyticsEvent {
  id                String    @id @default(cuid())
  eventType         String
  organizationId    String?
  userId            String?
  subscriptionId    String?
  customerAccountId String?
  planId            String?
  sessionId         String?
  source            String?
  metadata          Json?
  occurredAt        DateTime  @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([eventType, occurredAt])
  @@index([organizationId, occurredAt])
  @@map("platform_analytics_events")
}

// Master spec's "Restaurant Engagement Score" (0-100, weighted, admin
// configurable — §17/§18 of the Action Center document, churn analytics
// section of the main document). One row per computation, not updated in
// place, so score TRENDS over time are queryable — computed on demand by
// `EngagementScoreService` (live weighted sum of login/order/reservation/
// customer-growth/promotion/loyalty/feature-adoption signals against
// `PlatformAnalyticsConfig.engagementWeights`), persisted here so a
// dashboard can chart "score over the last 90 days" without recomputing
// history. The spec's explicit rule — predictions inform follow-up, they
// never auto-cancel an account — is enforced in `EngagementScoreService`
// and `ActionCenterService`, not at the schema layer.
model RestaurantEngagementSnapshot {
  id             String    @id @default(cuid())
  organizationId String
  score          Int
  classification String
  breakdown      Json
  computedAt     DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, computedAt])
  @@map("restaurant_engagement_snapshots")
}

// Singleton config row (same `id = "singleton"` convention as
// `PlatformBillingConfig`) for every admin-configurable number the Data
// Analytics + Action Center spec calls out: engagement-score weights,
// churn-risk thresholds, the anomaly-detection sensitivity, complaint SLA
// hours, and the renewal-reminder schedule (days-before-renewal to create a
// follow-up action).
model PlatformAnalyticsConfig {
  id                       String    @id
  engagementWeights        Json      @default("{\"login\":20,\"orders\":25,\"reservations\":15,\"customerGrowth\":15,\"promotions\":10,\"loyalty\":5,\"featureAdoption\":10}")
  anomalyThresholdPercent  Int       @default(30)
  complaintSlaHours        Int       @default(24)
  renewalReminderDays      Json      @default("[30, 14, 7, 3, 1]")
  inactivityDaysThreshold  Int       @default(14)
  updatedAt                DateTime  @updatedAt
  updatedByAdminId         String?

  @@map("platform_analytics_config")
}

// Master spec's "Custom Report Builder" (§ dashboards) — see this phase's
// header comment for why `config` is a constrained, validated JSON shape
// rather than an arbitrary query. `scheduleCron`/`lastRunAt` support the
// spec's "report scheduling" requirement (daily/weekly/monthly automated
// reports) — actually SENDING a scheduled report still needs an external
// trigger calling the same cron-secret-guarded route pattern
// `SubscriptionRetryService` already established in Phase 17 (this
// codebase has no in-process job runner), documented in the deployment
// checklist addendum for this phase.
model SavedReport {
  id              String    @id @default(cuid())
  name            String
  createdByAdminId String
  config          Json
  scheduleCron    String?
  lastRunAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  createdByAdmin PlatformAdmin @relation(fields: [createdByAdminId], references: [id], onDelete: Cascade)

  @@index([createdByAdminId])
  @@map("saved_reports")
}

// Master spec's export audit requirement (§ Data Security — "exports must
// be permission-controlled and audited"): who exported what, filtered how,
// how many rows, when. Written by `ExportService` before the file is
// streamed back, never after (so an export that the client aborts
// mid-stream is still on record).
model PlatformExportLog {
  id              String    @id @default(cuid())
  platformAdminId String
  reportType      String
  format          String
  filters         Json?
  rowCount        Int?
  createdAt       DateTime  @default(now())

  platformAdmin PlatformAdmin @relation(fields: [platformAdminId], references: [id], onDelete: Restrict)

  @@index([platformAdminId, createdAt])
  @@map("platform_export_logs")
}
